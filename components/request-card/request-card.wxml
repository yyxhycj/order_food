<view class="request-card" bindtap="handleTap">
  <image class="cover" src="{{request.recipeCoverImage || '/images/dish-placeholder.png'}}" mode="aspectFill"></image>
  <view class="content">
    <view class="header">
      <text class="title">{{request.recipeTitle}}</text>
      <text class="status status-{{request.status}}">{{request.statusText}}</text>
    </view>
    <text class="people" wx:if="{{mode === 'mine'}}">这道菜来自：{{request.authorNickname || '家里人'}}</text>
    <text class="people" wx:else>谁想吃：{{request.requesterNickname || '家里人'}}</text>
    <text class="reason" wx:if="{{request.reason}}">{{request.reason}}</text>
    <text class="reason muted" wx:else>没写原因，就是想吃。</text>
    <view class="footer">
      <text class="footer-text">{{request.createdAtText}}</text>
      <text wx:if="{{request.note}}" class="footer-text">{{request.note}}</text>
    </view>
    <view class="actions" catchtap="noop">
      <button wx:if="{{mode === 'mine' && request.canCancel}}" class="action ghost" data-action="cancel" bindtap="emitAction">先不吃</button>
      <button wx:if="{{mode !== 'mine' && request.canAccept}}" class="action primary" data-action="accept" bindtap="emitAction">安排上</button>
      <button wx:if="{{mode !== 'mine' && request.canDecline}}" class="action ghost" data-action="decline" bindtap="emitAction">改天</button>
      <button wx:if="{{mode !== 'mine' && request.canPrepare}}" class="action primary" data-action="prepare" bindtap="emitAction">开做</button>
      <button wx:if="{{mode !== 'mine' && request.canDone}}" class="action primary" data-action="done" bindtap="emitAction">吃过了</button>
    </view>
  </view>
</view>
