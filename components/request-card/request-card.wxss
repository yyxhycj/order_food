.request-card {
  display: flex;
  margin-bottom: 18rpx;
  padding: 16rpx;
  border: 1rpx solid #e6dbcd;
  border-radius: 8rpx;
  background: #fffdf8;
  overflow: hidden;
}

.cover {
  width: 150rpx;
  min-width: 150rpx;
  height: 150rpx;
  margin-right: 18rpx;
  border-radius: 8rpx;
  background: #f1ece5;
}

.content {
  flex: 1;
  min-width: 0;
}

.header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.title {
  flex: 1;
  min-width: 0;
  color: #241f1b;
  font-size: 31rpx;
  font-weight: 900;
  line-height: 40rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status {
  margin-left: 12rpx;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  color: #715f54;
  background: #f1ece5;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 28rpx;
}

.status-pending {
  color: #69481b;
  background: #f7dda4;
}

.status-accepted,
.status-preparing {
  color: #185f51;
  background: #d9efe8;
}

.status-done {
  color: #fff;
  background: #167a66;
}

.status-declined,
.status-cancelled {
  color: #77716d;
  background: #f0eeee;
}

.people,
.reason,
.footer-text {
  display: block;
  color: #716a61;
  font-size: 24rpx;
  line-height: 34rpx;
}

.people {
  margin-top: 8rpx;
}

.reason {
  margin-top: 4rpx;
}

.muted {
  color: #aaa29a;
}

.footer {
  display: flex;
  flex-wrap: wrap;
  margin-top: 8rpx;
}

.footer-text {
  margin-right: 16rpx;
  font-size: 22rpx;
}

.actions {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  margin-top: 10rpx;
}

.action {
  margin: 0 0 0 12rpx;
  padding: 0 18rpx;
  min-width: 108rpx;
  height: 54rpx;
  line-height: 54rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: 900;
}

.action::after {
  border: none;
}

.primary {
  color: #fff;
  background: #d84d35;
}

.ghost {
  color: #7a6558;
  background: #f4eee8;
}
