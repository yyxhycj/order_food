<view class="recipe-form">
  <view class="section">
    <text class="section-title">基础信息</text>
    <input class="input title-input" placeholder="菜名" value="{{form.title}}" data-field="title" bindinput="updateField" />
    <textarea class="textarea" placeholder="写几句这道菜的来历、味道或适合的场景" value="{{form.description}}" data-field="description" bindinput="updateField" maxlength="240"></textarea>

    <view class="cover-picker" bindtap="chooseCover">
      <image wx:if="{{form.coverImage}}" class="cover-image" src="{{form.coverImage}}" mode="aspectFill"></image>
      <view wx:else class="cover-placeholder">
        <text class="cover-plus">+</text>
        <text>添加主图</text>
      </view>
    </view>

    <view class="row">
      <picker class="picker" range="{{categories}}" range-key="name" bindchange="onCategoryChange">
        <text>{{form.categoryName || '选择分类'}}</text>
      </picker>
      <picker class="picker" range="{{timeOptions}}" bindchange="onTimeChange">
        <text>{{form.cookingTime}} 分钟</text>
      </picker>
    </view>

    <view class="difficulty">
      <block wx:for="{{difficultyOptions}}" wx:key="value">
        <view class="difficulty-item {{form.difficulty === item.value ? 'active' : ''}}" data-value="{{item.value}}" bindtap="selectDifficulty">
          {{item.label}}
        </view>
      </block>
    </view>

    <input class="input" placeholder="标签，用逗号分隔，例如 下饭, 周末" value="{{form.tagsText}}" data-field="tagsText" bindinput="updateField" />
  </view>

  <view class="section">
    <view class="section-head">
      <text class="section-title">食材</text>
      <button class="mini-button" bindtap="addIngredient">添加</button>
    </view>
    <block wx:for="{{form.ingredients}}" wx:key="index">
      <view class="ingredient-row">
        <input class="input ingredient-name" placeholder="食材" value="{{item.name}}" data-index="{{index}}" data-field="name" bindinput="updateIngredient" />
        <input class="input ingredient-amount" placeholder="用量" value="{{item.amount}}" data-index="{{index}}" data-field="amount" bindinput="updateIngredient" />
        <button class="remove-button" data-index="{{index}}" bindtap="removeIngredient">-</button>
      </view>
    </block>
  </view>

  <view class="section">
    <view class="section-head">
      <text class="section-title">步骤</text>
      <button class="mini-button" bindtap="addStep">添加</button>
    </view>
    <block wx:for="{{form.steps}}" wx:key="sort">
      <view class="step-block">
        <view class="step-index">{{index + 1}}</view>
        <view class="step-body">
          <textarea class="textarea step-textarea" placeholder="描述这一步怎么做" value="{{item.text}}" data-index="{{index}}" bindinput="updateStep"></textarea>
          <view class="step-image-picker" data-index="{{index}}" bindtap="chooseStepImage">
            <image wx:if="{{item.image}}" class="step-image" src="{{item.image}}" mode="aspectFill"></image>
            <text wx:else>添加步骤图</text>
          </view>
        </view>
        <button class="remove-button step-remove" data-index="{{index}}" bindtap="removeStep">-</button>
      </view>
    </block>
  </view>

  <view class="section">
    <text class="section-title">小贴士</text>
    <textarea class="textarea" placeholder="火候、替换食材、提前准备都可以写在这里" value="{{form.tips}}" data-field="tips" bindinput="updateField" maxlength="240"></textarea>
  </view>

  <view class="submit-bar">
    <button class="submit ghost" loading="{{submitting}}" bindtap="saveDraft">存草稿</button>
    <button class="submit primary" loading="{{submitting}}" bindtap="publish">发布</button>
  </view>
</view>
