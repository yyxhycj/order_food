.recipe-form {
  padding-bottom: 140rpx;
}

.section {
  margin: 22rpx 24rpx;
  padding: 24rpx;
  background: #fff;
  border: 1rpx solid #ece7df;
  border-radius: 8rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.section-title {
  display: block;
  margin-bottom: 16rpx;
  color: #332822;
  font-size: 30rpx;
  font-weight: 700;
}

.input,
.textarea,
.picker {
  width: 100%;
  box-sizing: border-box;
  border: 1rpx solid #e4dbd1;
  border-radius: 6rpx;
  background: #fffdf9;
  color: #332822;
  font-size: 28rpx;
}

.input,
.picker {
  height: 78rpx;
  line-height: 78rpx;
  padding: 0 20rpx;
  margin-bottom: 16rpx;
}

.title-input {
  font-weight: 700;
}

.textarea {
  min-height: 144rpx;
  padding: 18rpx 20rpx;
  line-height: 38rpx;
  margin-bottom: 16rpx;
}

.cover-picker {
  width: 100%;
  height: 320rpx;
  margin-bottom: 16rpx;
  border: 2rpx dashed #d6c8ba;
  border-radius: 8rpx;
  background: #f7f2ec;
  overflow: hidden;
}

.cover-image {
  width: 100%;
  height: 100%;
}

.cover-placeholder {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #9c7a63;
  font-size: 28rpx;
}

.cover-plus {
  font-size: 60rpx;
  line-height: 60rpx;
}

.row {
  display: flex;
}

.row .picker {
  flex: 1;
  min-width: 0;
  margin-right: 16rpx;
}

.row .picker:last-child {
  margin-right: 0;
}

.difficulty {
  display: flex;
  margin-bottom: 16rpx;
}

.difficulty-item {
  flex: 1;
  height: 68rpx;
  line-height: 68rpx;
  margin-right: 12rpx;
  border: 1rpx solid #e4dbd1;
  border-radius: 6rpx;
  color: #7c7067;
  text-align: center;
  font-size: 26rpx;
  background: #fffdf9;
}

.difficulty-item:last-child {
  margin-right: 0;
}

.difficulty-item.active {
  color: #fff;
  border-color: #9c5b37;
  background: #9c5b37;
}

.mini-button {
  margin: 0;
  padding: 0 18rpx;
  height: 56rpx;
  line-height: 56rpx;
  border-radius: 6rpx;
  color: #9c5b37;
  background: #f4eee8;
  font-size: 24rpx;
}

.mini-button::after,
.remove-button::after,
.submit::after {
  border: none;
}

.ingredient-row {
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
}

.ingredient-row .input {
  margin-bottom: 0;
}

.ingredient-name {
  flex: 1.1;
  min-width: 0;
  margin-right: 12rpx;
}

.ingredient-amount {
  flex: 1;
  min-width: 0;
  margin-right: 12rpx;
}

.remove-button {
  margin: 0;
  padding: 0;
  width: 56rpx;
  min-width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  border-radius: 50%;
  color: #8b6f5f;
  background: #f4eee8;
  font-size: 28rpx;
}

.step-block {
  display: flex;
  margin-bottom: 22rpx;
}

.step-index {
  width: 52rpx;
  height: 52rpx;
  line-height: 52rpx;
  border-radius: 50%;
  color: #fff;
  background: #9c5b37;
  text-align: center;
  font-weight: 700;
}

.step-body {
  flex: 1;
  min-width: 0;
  margin-left: 14rpx;
}

.step-textarea {
  min-height: 120rpx;
}

.step-image-picker {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 142rpx;
  border: 1rpx dashed #d6c8ba;
  border-radius: 6rpx;
  color: #9c7a63;
  background: #f7f2ec;
  font-size: 25rpx;
}

.step-image {
  width: 100%;
  height: 100%;
  border-radius: 6rpx;
}

.step-remove {
  margin-left: 12rpx;
}

.submit-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  padding: 18rpx 24rpx 30rpx;
  background: rgba(255, 253, 249, 0.96);
  border-top: 1rpx solid #eadfd4;
}

.submit {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 6rpx;
  font-size: 28rpx;
}

.submit.ghost {
  margin-right: 16rpx;
  color: #7a6558;
  background: #f4eee8;
}

.submit.primary {
  color: #fff;
  background: #9c5b37;
}
