.loading-state {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  color: #8a8078;
  font-size: 26rpx;
}

.spinner {
  width: 28rpx;
  height: 28rpx;
  margin-right: 14rpx;
  border: 4rpx solid #e2d8ce;
  border-top-color: #d84d35;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}
