<view class="profile-page">
  <view class="profile-card">
    <image class="avatar" src="{{userInfo.avatarUrl || '/images/default-avatar.png'}}" mode="aspectFill" bindtap="changeAvatar"></image>
    <view class="profile-info">
      <text class="name">{{userInfo.nickname || '新朋友'}}</text>
      <text class="bio">{{userInfo.bio || '还没有写简介'}}</text>
      <text class="role">{{isAdmin ? '管理员' : '朋友'}}</text>
    </view>
    <button class="edit-button" bindtap="openEditModal">编辑</button>
  </view>

  <view class="stats">
    <view class="stat">
      <text class="stat-number">{{stats.recipeCount}}</text>
      <text class="stat-label">菜谱</text>
    </view>
    <view class="stat">
      <text class="stat-number">{{stats.favoriteCount}}</text>
      <text class="stat-label">收藏</text>
    </view>
    <view class="stat">
      <text class="stat-number">{{stats.requestCount}}</text>
      <text class="stat-label">想吃</text>
    </view>
    <view class="stat">
      <text class="stat-number">{{stats.receivedRequestCount}}</text>
      <text class="stat-label">收到</text>
    </view>
  </view>

  <view class="menu">
    <view class="menu-item" bindtap="goToCreate">
      <text class="menu-main">发布菜谱</text>
      <text class="menu-sub">把拿手菜分享给朋友</text>
    </view>
    <view class="menu-item" bindtap="goToMyRecipes">
      <text class="menu-main">我的菜谱</text>
      <text class="menu-sub">查看和编辑我发布的菜谱</text>
    </view>
    <view class="menu-item" bindtap="goToFavorites">
      <text class="menu-main">我的收藏</text>
      <text class="menu-sub">留着下次想吃</text>
    </view>
    <view class="menu-item" bindtap="goToMyRequests">
      <text class="menu-main">我的想吃</text>
      <text class="menu-sub">查看请求状态</text>
    </view>
    <view class="menu-item" bindtap="goToReceivedRequests">
      <text class="menu-main">收到的想吃</text>
      <text class="menu-sub">回应朋友的请求</text>
    </view>
    <view wx:if="{{isAdmin}}" class="menu-item admin" bindtap="goToAdmin">
      <text class="menu-main">管理入口</text>
      <text class="menu-sub">分类、菜谱和请求</text>
    </view>
  </view>

  <view class="modal-mask" wx:if="{{showEditModal}}" bindtap="closeEditModal">
    <view class="modal" catchtap="noop">
      <text class="modal-title">编辑资料</text>
      <input class="input" placeholder="昵称" value="{{editForm.nickname}}" bindinput="onNicknameInput" />
      <textarea class="textarea" placeholder="介绍一下自己" value="{{editForm.bio}}" bindinput="onBioInput" maxlength="120"></textarea>
      <view class="modal-actions">
        <button class="modal-button ghost" bindtap="closeEditModal">取消</button>
        <button class="modal-button primary" bindtap="saveProfile">保存</button>
      </view>
    </view>
  </view>
</view>
