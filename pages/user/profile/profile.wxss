page {
  background: #f7f3ea;
}

.profile-page {
  min-height: 100vh;
  padding: 30rpx 24rpx 48rpx;
  box-sizing: border-box;
}

.top,
.profile-card,
.section-head,
.pending-item {
  display: flex;
  align-items: center;
}

.top,
.section-head {
  justify-content: space-between;
}

.top {
  margin-bottom: 24rpx;
}

.title {
  display: block;
  color: #241f1b;
  font-size: 48rpx;
  font-weight: 900;
  line-height: 58rpx;
}

.subtitle {
  display: block;
  margin-top: 8rpx;
  color: #716a61;
  font-size: 25rpx;
  line-height: 34rpx;
}

.edit-round {
  margin: 0;
  padding: 0;
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  color: #fff;
  background: #d84d35;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 76rpx;
}

.edit-round::after,
.modal-button::after {
  border: none;
}

.profile-card {
  padding: 24rpx;
  border: 1rpx solid #e6dbcd;
  border-radius: 8rpx;
  background: #fffdf8;
}

.avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: #eee6dc;
}

.profile-info {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.name {
  display: block;
  color: #241f1b;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 42rpx;
}

.bio {
  display: block;
  margin-top: 8rpx;
  color: #716a61;
  font-size: 24rpx;
  line-height: 34rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.role {
  margin-left: 16rpx;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  color: #185f51;
  background: #d9efe8;
  font-size: 22rpx;
  font-weight: 900;
}

.stats {
  display: flex;
  margin: 20rpx 0;
}

.stat {
  flex: 1;
  margin-right: 12rpx;
  padding: 18rpx 8rpx;
  border: 1rpx solid #e6dbcd;
  border-radius: 8rpx;
  background: #fffdf8;
  text-align: center;
}

.stat:last-child {
  margin-right: 0;
}

.stat-number {
  display: block;
  color: #d84d35;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 40rpx;
}

.stat-label {
  display: block;
  margin-top: 4rpx;
  color: #716a61;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 30rpx;
}

.chef-card {
  padding: 24rpx;
  border-radius: 8rpx;
  color: #183d37;
  background: #d9efe8;
}

.section-title {
  display: block;
  color: #241f1b;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 40rpx;
}

.section-sub {
  display: block;
  margin-top: 8rpx;
  color: #32645b;
  font-size: 24rpx;
  line-height: 34rpx;
}

.chef-options {
  display: flex;
  margin-top: 18rpx;
}

.chef-option {
  flex: 1;
  margin-right: 12rpx;
  height: 66rpx;
  border: 1rpx solid #b7d7cd;
  border-radius: 8rpx;
  color: #276257;
  background: rgba(255, 255, 255, 0.58);
  font-size: 25rpx;
  font-weight: 900;
  line-height: 64rpx;
  text-align: center;
}

.chef-option:last-child {
  margin-right: 0;
}

.chef-option.active {
  color: #fff;
  border-color: #167a66;
  background: #167a66;
}

.section {
  margin-top: 22rpx;
}

.section-head {
  margin-bottom: 14rpx;
}

.section-action {
  color: #d84d35;
  font-size: 25rpx;
  font-weight: 900;
}

.pending-item {
  margin-bottom: 14rpx;
  padding: 14rpx;
  border: 1rpx solid #e6dbcd;
  border-radius: 8rpx;
  background: #fffdf8;
}

.pending-cover {
  width: 86rpx;
  height: 86rpx;
  margin-right: 16rpx;
  border-radius: 8rpx;
  background: #eee6dc;
}

.pending-body {
  flex: 1;
  min-width: 0;
}

.pending-title {
  display: block;
  color: #241f1b;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 36rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pending-sub {
  display: block;
  margin-top: 6rpx;
  color: #716a61;
  font-size: 23rpx;
  line-height: 30rpx;
}

.pending-status {
  margin-left: 12rpx;
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  color: #69481b;
  background: #f7dda4;
  font-size: 22rpx;
  font-weight: 900;
}

.empty-line {
  padding: 24rpx;
  border: 1rpx dashed #dfd2c3;
  border-radius: 8rpx;
  color: #81786f;
  background: #fffdf8;
  font-size: 26rpx;
  line-height: 36rpx;
}

.menu-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 22rpx -8rpx 0;
}

.menu-tile {
  width: calc(50% - 16rpx);
  min-height: 128rpx;
  margin: 0 8rpx 16rpx;
  padding: 22rpx;
  border: 1rpx solid #e6dbcd;
  border-radius: 8rpx;
  background: #fffdf8;
  box-sizing: border-box;
}

.menu-tile.admin {
  background: #fff8e7;
}

.menu-main {
  display: block;
  color: #241f1b;
  font-size: 29rpx;
  font-weight: 900;
  line-height: 38rpx;
}

.menu-sub {
  display: block;
  margin-top: 8rpx;
  color: #716a61;
  font-size: 23rpx;
  line-height: 32rpx;
}

.modal-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(30, 24, 20, 0.46);
  z-index: 10;
}

.modal {
  width: 100%;
  padding: 28rpx 24rpx 40rpx;
  border-radius: 8rpx 8rpx 0 0;
  background: #fffdf8;
  box-sizing: border-box;
}

.modal-title {
  display: block;
  margin-bottom: 18rpx;
  color: #241f1b;
  font-size: 34rpx;
  font-weight: 900;
}

.input,
.textarea {
  width: 100%;
  box-sizing: border-box;
  border: 1rpx solid #e4dbd1;
  border-radius: 8rpx;
  background: #fff;
  color: #332822;
  font-size: 28rpx;
}

.input {
  height: 78rpx;
  line-height: 78rpx;
  padding: 0 18rpx;
  margin-bottom: 16rpx;
}

.textarea {
  height: 160rpx;
  padding: 18rpx;
  line-height: 38rpx;
}

.modal-actions {
  display: flex;
  margin-top: 22rpx;
}

.modal-button {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  font-weight: 900;
}

.modal-button.ghost {
  margin-right: 16rpx;
  color: #7a6558;
  background: #f4eee8;
}

.modal-button.primary {
  color: #fff;
  background: #d84d35;
}
