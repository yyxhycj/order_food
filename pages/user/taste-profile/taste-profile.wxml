<view class="taste-profile-container">
  <!-- 页面头部 -->
  <view class="page-header">
    <text class="page-title">口味档案</text>
    <text class="page-subtitle">完善您的口味偏好，获得更精准的推荐</text>
  </view>

  <!-- 档案完成度 -->
  <view class="completion-card">
    <view class="completion-header">
      <text class="completion-title">档案完成度</text>
      <text class="completion-percentage">{{completionPercentage}}%</text>
    </view>
    <view class="completion-progress">
      <view class="progress-bar">
        <view class="progress-fill" style="width: {{completionPercentage}}%"></view>
      </view>
    </view>
    <text class="completion-desc">完成度越高，推荐越精准</text>
  </view>

  <!-- 基本口味偏好 -->
  <view class="preference-section">
    <view class="section-header">
      <text class="section-title">基本口味偏好</text>
    </view>
    
    <!-- 辣度偏好 -->
    <view class="preference-item">
      <view class="preference-label">
        <text class="label-text">辣度偏好</text>
        <text class="label-required">*</text>
      </view>
      <view class="radio-group">
        <view class="radio-item {{spiceLevel === 'mild' ? 'active' : ''}}" 
              bindtap="onSpiceLevelChange" data-value="mild">
          <text class="radio-emoji">🥛</text>
          <text class="radio-text">清淡</text>
        </view>
        <view class="radio-item {{spiceLevel === 'medium' ? 'active' : ''}}" 
              bindtap="onSpiceLevelChange" data-value="medium">
          <text class="radio-emoji">🌶️</text>
          <text class="radio-text">中辣</text>
        </view>
        <view class="radio-item {{spiceLevel === 'spicy' ? 'active' : ''}}" 
              bindtap="onSpiceLevelChange" data-value="spicy">
          <text class="radio-emoji">🔥</text>
          <text class="radio-text">重辣</text>
        </view>
        <view class="radio-item {{spiceLevel === 'extra_spicy' ? 'active' : ''}}" 
              bindtap="onSpiceLevelChange" data-value="extra_spicy">
          <text class="radio-emoji">🌋</text>
          <text class="radio-text">特辣</text>
        </view>
      </view>
    </view>

    <!-- 甜度偏好 -->
    <view class="preference-item">
      <view class="preference-label">
        <text class="label-text">甜度偏好</text>
        <text class="label-required">*</text>
      </view>
      <view class="radio-group">
        <view class="radio-item {{sweetnessLevel === 'low' ? 'active' : ''}}" 
              bindtap="onSweetnessLevelChange" data-value="low">
          <text class="radio-emoji">🧂</text>
          <text class="radio-text">微甜</text>
        </view>
        <view class="radio-item {{sweetnessLevel === 'medium' ? 'active' : ''}}" 
              bindtap="onSweetnessLevelChange" data-value="medium">
          <text class="radio-emoji">🍯</text>
          <text class="radio-text">适中</text>
        </view>
        <view class="radio-item {{sweetnessLevel === 'high' ? 'active' : ''}}" 
              bindtap="onSweetnessLevelChange" data-value="high">
          <text class="radio-emoji">🍰</text>
          <text class="radio-text">偏甜</text>
        </view>
      </view>
    </view>

    <!-- 烹饪技能等级 -->
    <view class="preference-item">
      <view class="preference-label">
        <text class="label-text">烹饪技能</text>
        <text class="label-required">*</text>
      </view>
      <view class="radio-group">
        <view class="radio-item {{cookingSkillLevel === 'beginner' ? 'active' : ''}}" 
              bindtap="onCookingSkillChange" data-value="beginner">
          <text class="radio-emoji">🥚</text>
          <text class="radio-text">初学者</text>
        </view>
        <view class="radio-item {{cookingSkillLevel === 'intermediate' ? 'active' : ''}}" 
              bindtap="onCookingSkillChange" data-value="intermediate">
          <text class="radio-emoji">🥘</text>
          <text class="radio-text">中级</text>
        </view>
        <view class="radio-item {{cookingSkillLevel === 'advanced' ? 'active' : ''}}" 
              bindtap="onCookingSkillChange" data-value="advanced">
          <text class="radio-emoji">👨‍🍳</text>
          <text class="radio-text">高级</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 口味偏好 -->
  <view class="preference-section">
    <view class="section-header">
      <text class="section-title">口味偏好</text>
      <text class="section-subtitle">多选</text>
    </view>
    <view class="tag-group">
      <view class="tag-item {{flavorPreferences.includes(item.value) ? 'active' : ''}}" 
            wx:for="{{flavorOptions}}" wx:key="value"
            bindtap="onFlavorToggle" data-value="{{item.value}}">
        <text class="tag-emoji">{{item.emoji}}</text>
        <text class="tag-text">{{item.label}}</text>
      </view>
    </view>
  </view>

  <!-- 菜系偏好 -->
  <view class="preference-section">
    <view class="section-header">
      <text class="section-title">菜系偏好</text>
      <text class="section-subtitle">多选</text>
    </view>
    <view class="tag-group">
      <view class="tag-item {{cuisinePreferences.includes(item.value) ? 'active' : ''}}" 
            wx:for="{{cuisineOptions}}" wx:key="value"
            bindtap="onCuisineToggle" data-value="{{item.value}}">
        <text class="tag-emoji">{{item.emoji}}</text>
        <text class="tag-text">{{item.label}}</text>
      </view>
    </view>
  </view>

  <!-- 饮食限制 -->
  <view class="preference-section">
    <view class="section-header">
      <text class="section-title">饮食限制</text>
      <text class="section-subtitle">可选</text>
    </view>
    <view class="tag-group">
      <view class="tag-item {{dietaryRestrictions.includes(item.value) ? 'active' : ''}}" 
            wx:for="{{dietaryOptions}}" wx:key="value"
            bindtap="onDietaryToggle" data-value="{{item.value}}">
        <text class="tag-emoji">{{item.emoji}}</text>
        <text class="tag-text">{{item.label}}</text>
      </view>
    </view>
  </view>

  <!-- 过敏信息 -->
  <view class="preference-section">
    <view class="section-header">
      <text class="section-title">过敏信息</text>
      <text class="section-subtitle">可选</text>
    </view>
    <view class="tag-group">
      <view class="tag-item {{allergies.includes(item.value) ? 'active' : ''}}" 
            wx:for="{{allergyOptions}}" wx:key="value"
            bindtap="onAllergyToggle" data-value="{{item.value}}">
        <text class="tag-emoji">{{item.emoji}}</text>
        <text class="tag-text">{{item.label}}</text>
      </view>
    </view>
  </view>

  <!-- 智能分析 -->
  <view class="analysis-section" wx:if="{{analysisResult}}">
    <view class="section-header">
      <text class="section-title">智能分析</text>
      <text class="section-subtitle">基于您的偏好</text>
    </view>
    <view class="analysis-card">
      <view class="analysis-item">
        <text class="analysis-label">口味类型</text>
        <text class="analysis-value">{{analysisResult.tasteType}}</text>
      </view>
      <view class="analysis-item">
        <text class="analysis-label">推荐菜系</text>
        <text class="analysis-value">{{analysisResult.recommendedCuisine}}</text>
      </view>
      <view class="analysis-item">
        <text class="analysis-label">适合难度</text>
        <text class="analysis-value">{{analysisResult.suitableDifficulty}}</text>
      </view>
    </view>
  </view>

  <!-- 操作按钮 -->
  <view class="action-buttons">
    <button class="save-button" bindtap="onSave" disabled="{{!canSave}}">
      保存档案
    </button>
    <button class="analyze-button" bindtap="onAnalyze" disabled="{{!canAnalyze}}">
      智能分析
    </button>
  </view>
</view> 