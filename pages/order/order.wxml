<!--pages/order/order.wxml-->
<view class="container">
  <!-- 愿望菜品列表 -->
  <view class="order-section">
    <view class="section-title">愿望菜品</view>
    <view class="product-list">
      <view class="product-item" wx:for="{{wishListItems}}" wx:key="id">
        <image src="{{item.image}}" class="product-image"></image>
        <view class="product-info">
          <text class="product-name">{{item.dish_name || item.name}}</text>
          <view class="product-bottom">
            <text class="product-quantity">x{{item.quantity}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 请求原因 -->
  <view class="order-section">
    <view class="section-title">请求原因</view>
    <textarea class="textarea" placeholder="请简单说明您的需求和情况..." value="{{requestReason}}" bindinput="onReasonInput" maxlength="200"></textarea>
  </view>

  <!-- 紧急程度 -->
  <view class="order-section">
    <view class="section-title">紧急程度</view>
    <radio-group bindchange="onUrgencyChange">
      <label class="radio-item">
        <radio value="low" checked="{{urgency === 'low'}}"/> 
        <text>一般 - 有空的时候</text>
      </label>
      <label class="radio-item">
        <radio value="normal" checked="{{urgency === 'normal'}}"/> 
        <text>普通 - 今天内</text>
      </label>
      <label class="radio-item">
        <radio value="high" checked="{{urgency === 'high'}}"/> 
        <text>紧急 - 尽快</text>
      </label>
    </radio-group>
  </view>

  <!-- 提交按钮 -->
  <view class="submit-section">
    <button class="submit-btn" bindtap="submitRequest">
      提交请求
    </button>
  </view>
</view> 