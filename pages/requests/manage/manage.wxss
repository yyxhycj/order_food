page {
  background: #f7f3ea;
}

.manage-page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}

.summary {
  margin-bottom: 22rpx;
  padding: 24rpx;
  border: 1rpx solid #e6dbcd;
  border-radius: 8rpx;
  background: #fffdf8;
}

.summary-title {
  display: block;
  color: #241f1b;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 44rpx;
}

.summary-subtitle {
  display: block;
  margin-top: 8rpx;
  color: #7f746b;
  font-size: 26rpx;
  line-height: 34rpx;
}

.status-tabs {
  white-space: nowrap;
  margin-bottom: 20rpx;
}

.status-tab {
  display: inline-block;
  margin-right: 14rpx;
  padding: 14rpx 24rpx;
  border: 1rpx solid #e3d9ce;
  border-radius: 999rpx;
  color: #6f6259;
  background: #fffdf9;
  font-size: 26rpx;
}

.status-tab.active {
  color: #fff;
  border-color: #167a66;
  background: #167a66;
}
