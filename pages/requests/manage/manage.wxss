page {
  background: #fbf7f1;
}

.manage-page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}

.summary {
  margin-bottom: 22rpx;
  padding: 24rpx;
  border: 1rpx solid #ece7df;
  border-radius: 8rpx;
  background: #fff;
}

.summary-title {
  display: block;
  color: #2b211b;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 44rpx;
}

.summary-subtitle {
  display: block;
  margin-top: 8rpx;
  color: #7f746b;
  font-size: 26rpx;
  line-height: 34rpx;
}

.status-tabs {
  white-space: nowrap;
  margin-bottom: 20rpx;
}

.status-tab {
  display: inline-block;
  margin-right: 14rpx;
  padding: 14rpx 24rpx;
  border: 1rpx solid #e3d9ce;
  border-radius: 6rpx;
  color: #6f6259;
  background: #fffdf9;
  font-size: 26rpx;
}

.status-tab.active {
  color: #fff;
  border-color: #9c5b37;
  background: #9c5b37;
}
