/* pages/admin/store-config/store-config.wxss */
.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 120rpx;
}

/* 页面头部 */
.header {
  background-color: #fff;
  padding: 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1rpx solid #eee;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.btn-preview {
  background-color: #ff6b6b;
  color: white;
  border: none;
}

/* 预览区域 */
.preview-section {
  margin: 20rpx;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.preview-store-info {
  background: linear-gradient(135deg, #ff6b6b 0%, #ff8e8e 100%);
  padding: 40rpx 30rpx 30rpx;
  color: white;
  position: relative;
  overflow: hidden;
}

.preview-banner-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  opacity: 0.8;
  z-index: 1;
}

.preview-store-header, .preview-store-stats {
  position: relative;
  z-index: 2;
}

.preview-store-header {
  margin-bottom: 20rpx;
}

.preview-store-name {
  font-size: 42rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.preview-store-subtitle {
  font-size: 28rpx;
  opacity: 0.9;
}

.preview-rating {
  display: flex;
  align-items: center;
  gap: 20rpx;
  font-size: 24rpx;
}

.preview-rating-score {
  background-color: rgba(255, 255, 255, 0.2);
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-weight: bold;
}

.preview-rating-text, .preview-rating-percent {
  opacity: 0.9;
}

/* 表单容器 */
.form-container {
  padding: 20rpx;
}

.form-section {
  background-color: #fff;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  padding: 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 30rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #ff6b6b;
}

.form-item {
  margin-bottom: 30rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.label {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.input {
  width: 100%;
  height: 80rpx;
  background-color: #f8f9fa;
  border: 2rpx solid #e9ecef;
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.input:focus {
  border-color: #ff6b6b;
  background-color: #fff;
}

/* 颜色输入 */
.color-input-wrapper {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.color-input {
  flex: 1;
}

.color-preview {
  width: 80rpx;
  height: 80rpx;
  border-radius: 8rpx;
  border: 2rpx solid #e9ecef;
  flex-shrink: 0;
}

/* 图片上传 */
.image-upload {
  width: 100%;
  height: 200rpx;
  background-color: #f8f9fa;
  border: 2rpx dashed #ccc;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
}

.preview-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  border-radius: 6rpx;
}

.upload-placeholder {
  text-align: center;
  color: #999;
}

.upload-icon {
  display: block;
  font-size: 48rpx;
  margin-bottom: 16rpx;
}

.upload-text {
  font-size: 24rpx;
}

/* 底部按钮 */
.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #fff;
  padding: 20rpx 30rpx;
  border-top: 1rpx solid #eee;
  display: flex;
  gap: 20rpx;
}

.btn-primary, .btn-secondary {
  flex: 1;
  height: 80rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  font-weight: bold;
  border: none;
}

.btn-primary {
  background-color: #ff6b6b;
  color: white;
}

.btn-secondary {
  background-color: #f8f9fa;
  color: #666;
  border: 2rpx solid #e9ecef;
}

.btn-primary:disabled {
  background-color: #ccc;
}

.btn-secondary:disabled {
  background-color: #f5f5f5;
  color: #999;
} 