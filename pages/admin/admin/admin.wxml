<view class="admin-page">
  <view class="header">
    <text class="title">轻量管理</text>
    <text class="subtitle">管一下菜单、分类和点菜记录。</text>
  </view>

  <view class="stats">
    <view class="stat">
      <text class="stat-number">{{stats.recipeCount}}</text>
      <text class="stat-label">菜单</text>
    </view>
    <view class="stat">
      <text class="stat-number">{{stats.requestCount}}</text>
      <text class="stat-label">点菜</text>
    </view>
    <view class="stat">
      <text class="stat-number">{{stats.categoryCount}}</text>
      <text class="stat-label">分类</text>
    </view>
  </view>

  <view class="menu">
    <view class="menu-item" bindtap="goCategories">
      <text class="menu-main">分类管理</text>
      <text class="menu-sub">维护首页筛选分类</text>
    </view>
    <view class="menu-item" bindtap="goRecipes">
      <text class="menu-main">菜单管理</text>
      <text class="menu-sub">查看、隐藏或编辑家里的菜</text>
    </view>
    <view class="menu-item" bindtap="goRequests">
      <text class="menu-main">点菜管理</text>
      <text class="menu-sub">看看谁想吃，方便就安排</text>
    </view>
  </view>
</view>
