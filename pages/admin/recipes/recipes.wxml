<view class="recipes-page">
  <view class="toolbar">
    <text class="title">{{title}}</text>
    <button wx:if="{{scope !== 'favorites'}}" class="create-button" bindtap="createRecipe">新增</button>
  </view>

  <loading-state wx:if="{{loading}}" text="正在打开菜单"></loading-state>

  <view wx:else>
    <block wx:if="{{recipes.length}}">
      <view class="recipe-row" wx:for="{{recipes}}" wx:key="_id">
        <recipe-card recipe="{{item}}" show-status="{{scope !== 'favorites'}}" bind:recipetap="goToRecipe"></recipe-card>
        <view class="actions" wx:if="{{scope !== 'favorites'}}">
          <button class="row-button ghost" data-id="{{item._id}}" bindtap="editRecipe">编辑</button>
          <button wx:if="{{item.status !== 'published'}}" class="row-button primary" data-id="{{item._id}}" bindtap="publishRecipe">发布</button>
          <button wx:if="{{item.status === 'published'}}" class="row-button ghost" data-id="{{item._id}}" bindtap="hideRecipe">隐藏</button>
          <button class="row-button danger" data-id="{{item._id}}" bindtap="deleteRecipe">删除</button>
        </view>
      </view>
    </block>
    <empty-state
      wx:else
      title="{{scope === 'favorites' ? '还没有留着的菜' : '菜单还是空的'}}"
      description="{{scope === 'favorites' ? '看到下次想吃的菜，就先留着。' : '加一道家里常吃的菜。'}}"
      button-text="{{scope === 'favorites' ? '去菜单' : '加一道菜'}}"
      bind:action="onEmptyAction"
    ></empty-state>
  </view>
</view>
