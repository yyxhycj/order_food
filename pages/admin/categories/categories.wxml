<view class="categories-page">
  <button class="create-button" bindtap="openCreate">新增分类</button>

  <view class="category-list">
    <view class="category-item" wx:for="{{categories}}" wx:key="_id" data-index="{{index}}" bindtap="openEdit">
      <view class="category-main">
        <text class="category-name">{{item.name}}</text>
        <text class="category-desc">{{item.description || '没有描述'}}</text>
      </view>
      <text class="category-sort">{{item.sort || 0}}</text>
    </view>
  </view>

  <view class="modal-mask" wx:if="{{showModal}}" bindtap="closeModal">
    <view class="modal" catchtap="noop">
      <text class="modal-title">{{editingId ? '编辑分类' : '新增分类'}}</text>
      <input class="input" placeholder="分类名称" value="{{form.name}}" data-field="name" bindinput="onInput" />
      <input class="input" placeholder="图标标识" value="{{form.icon}}" data-field="icon" bindinput="onInput" />
      <input class="input" type="number" placeholder="排序" value="{{form.sort}}" data-field="sort" bindinput="onInput" />
      <textarea class="textarea" placeholder="分类描述" value="{{form.description}}" data-field="description" bindinput="onInput"></textarea>
      <view class="modal-actions">
        <button class="modal-button ghost" bindtap="closeModal">取消</button>
        <button class="modal-button primary" bindtap="saveCategory">保存</button>
      </view>
    </view>
  </view>
</view>
