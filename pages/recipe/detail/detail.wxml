<view class="detail-page">
  <loading-state wx:if="{{loading}}" text="正在打开这道菜"></loading-state>

  <block wx:elif="{{recipe}}">
    <image class="hero" src="{{recipe.coverImage || '/images/dish-placeholder.png'}}" mode="aspectFill" bindtap="previewCover"></image>

    <view class="panel">
      <view class="title-row">
        <text class="title">{{recipe.title}}</text>
        <button wx:if="{{canEdit}}" class="edit-button" bindtap="editRecipe">编辑</button>
      </view>
      <text class="desc">{{recipe.description}}</text>

      <view class="author-row">
        <user-avatar user="{{recipe}}" size="small"></user-avatar>
        <text class="time">{{recipe.createdAtText}}</text>
      </view>

      <view class="metrics">
        <view class="metric">
          <text class="metric-number">{{recipe.cookingTime || 0}}</text>
          <text class="metric-label">分钟</text>
        </view>
        <view class="metric">
          <text class="metric-number">{{recipe.difficultyText}}</text>
          <text class="metric-label">难度</text>
        </view>
        <view class="metric">
          <text class="metric-number">{{recipe.wantCount || 0}}</text>
          <text class="metric-label">想吃</text>
        </view>
        <view class="metric">
          <text class="metric-number">{{recipe.favoriteCount || 0}}</text>
          <text class="metric-label">留着</text>
        </view>
      </view>

      <view class="tags" wx:if="{{recipe.tags.length}}">
        <text wx:for="{{recipe.tags}}" wx:key="*this" class="tag">{{item}}</text>
      </view>
    </view>

    <view class="section">
      <text class="section-title">食材</text>
      <view class="ingredient" wx:for="{{recipe.ingredients}}" wx:key="name">
        <text>{{item.name}}</text>
        <text>{{item.amount}}</text>
      </view>
    </view>

    <view class="section">
      <text class="section-title">步骤</text>
      <view class="step" wx:for="{{recipe.steps}}" wx:key="sort">
        <view class="step-index">{{index + 1}}</view>
        <view class="step-body">
          <text class="step-text">{{item.text}}</text>
          <image wx:if="{{item.image}}" class="step-image" src="{{item.image}}" mode="aspectFill" data-image="{{item.image}}" bindtap="previewStepImage"></image>
        </view>
      </view>
    </view>

    <view class="section" wx:if="{{recipe.tips}}">
      <text class="section-title">小贴士</text>
      <text class="tips">{{recipe.tips}}</text>
    </view>

    <view class="section comments-section">
      <view class="section-head">
        <text class="section-title inline">饭桌留言</text>
        <text class="section-count">{{recipe.commentCount || comments.length || 0}}</text>
      </view>

      <view wx:if="{{comments.length}}" class="comment-list">
        <view class="comment-item" wx:for="{{comments}}" wx:key="_id">
          <view class="comment-head">
            <user-avatar user="{{item}}" size="small"></user-avatar>
            <text class="comment-time">{{item.createdAtText}}</text>
          </view>
          <text class="comment-content">{{item.content}}</text>
          <button wx:if="{{item.canDelete}}" class="comment-delete" data-id="{{item._id}}" loading="{{deletingCommentId === item._id}}" bindtap="deleteComment">删除</button>
        </view>
      </view>

      <view wx:else class="comment-empty">还没有留言。</view>

      <view class="comment-form">
        <textarea class="comment-input" placeholder="给这道菜留一句话" value="{{commentText}}" bindinput="onCommentInput" maxlength="200"></textarea>
        <button class="comment-submit" loading="{{submittingComment}}" bindtap="submitComment">发送留言</button>
      </view>
    </view>

    <view class="bottom-actions">
      <button class="action secondary" loading="{{togglingFavorite}}" bindtap="toggleFavorite">{{isFavorite ? '已留着' : '留着'}}</button>
      <button class="action primary" bindtap="openRequestModal">想吃这个</button>
    </view>

    <view class="modal-mask" wx:if="{{showRequestModal}}" bindtap="closeRequestModal">
      <view class="modal" catchtap="noop">
        <text class="modal-title">想吃这个</text>
        <textarea class="reason-input" placeholder="比如：今晚想吃热乎的，或者周末一起弄" value="{{requestReason}}" bindinput="onReasonInput" maxlength="120"></textarea>
        <view class="modal-actions">
          <button class="modal-button ghost" bindtap="closeRequestModal">取消</button>
          <button class="modal-button primary" loading="{{submittingRequest}}" bindtap="submitRequest">放进想吃</button>
        </view>
      </view>
    </view>
  </block>

  <empty-state wx:else title="这道菜不见了" button-text="回首页" bind:action="goHome"></empty-state>
</view>
