page {
  background: #f7f3ea;
}

.home-page {
  min-height: 100vh;
  padding: 30rpx 24rpx 48rpx;
  box-sizing: border-box;
}

.top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.brand {
  min-width: 0;
}

.title {
  display: block;
  color: #241f1b;
  font-size: 48rpx;
  font-weight: 900;
  line-height: 58rpx;
}

.subtitle {
  display: block;
  margin-top: 8rpx;
  color: #716a61;
  font-size: 25rpx;
  line-height: 34rpx;
}

.create-button {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  color: #fff;
  background: #d84d35;
  font-size: 44rpx;
  font-weight: 500;
  line-height: 76rpx;
}

.create-button::after,
.search-button::after,
.clear::after,
.want-button::after {
  border: none;
}

.search {
  display: flex;
  align-items: center;
  height: 82rpx;
  margin-bottom: 22rpx;
  border: 1rpx solid #e6dbcd;
  border-radius: 8rpx;
  background: #fffdf8;
  overflow: hidden;
}

.search-input {
  flex: 1;
  height: 82rpx;
  padding: 0 24rpx;
  color: #332822;
  font-size: 27rpx;
}

.clear {
  margin: 0;
  padding: 0;
  width: 56rpx;
  height: 56rpx;
  line-height: 52rpx;
  color: #8b8179;
  background: transparent;
  font-size: 38rpx;
}

.search-button {
  margin: 0;
  padding: 0 24rpx;
  height: 82rpx;
  line-height: 82rpx;
  color: #fff;
  background: #167a66;
  border-radius: 0;
  font-size: 26rpx;
  font-weight: 800;
}

.categories {
  white-space: nowrap;
  margin-bottom: 18rpx;
}

.category {
  display: inline-block;
  margin-right: 14rpx;
  padding: 14rpx 24rpx;
  border: 1rpx solid #e3d9ce;
  border-radius: 999rpx;
  color: #6f6259;
  background: #fffdf8;
  font-size: 26rpx;
  font-weight: 700;
}

.category.active {
  color: #fff;
  border-color: #167a66;
  background: #167a66;
}

.sorts {
  display: flex;
  margin-bottom: 22rpx;
}

.sort {
  margin-right: 28rpx;
  padding-bottom: 8rpx;
  color: #7e756d;
  font-size: 26rpx;
}

.sort.active {
  color: #d84d35;
  font-weight: 800;
  border-bottom: 4rpx solid #d84d35;
}

.menu-list {
  padding-bottom: 24rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 26rpx 0 14rpx;
}

.section-title {
  color: #241f1b;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 42rpx;
}

.section-action {
  color: #d84d35;
  font-size: 25rpx;
  font-weight: 800;
}

.featured-card {
  display: grid;
  grid-template-columns: 236rpx 1fr;
  gap: 22rpx;
  padding: 18rpx;
  border: 1rpx solid #e6dbcd;
  border-radius: 8rpx;
  background: #fffdf8;
}

.featured-cover {
  width: 236rpx;
  height: 236rpx;
  border-radius: 8rpx;
  background: #eee6dc;
}

.featured-body {
  min-width: 0;
}

.featured-title {
  display: block;
  color: #241f1b;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 44rpx;
}

.featured-meta {
  display: block;
  margin-top: 10rpx;
  color: #716a61;
  font-size: 25rpx;
  line-height: 34rpx;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.food-tag {
  margin: 0 10rpx 10rpx 0;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  color: #534a42;
  background: #f1e4d1;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 28rpx;
}

.food-tag.warm {
  color: #9c311e;
  background: #f7d8d1;
}

.food-tag.fresh {
  color: #12594b;
  background: #d9efe8;
}

.want-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 148rpx;
  height: 62rpx;
  margin: 8rpx 0 0;
  padding: 0;
  border-radius: 8rpx;
  color: #fff;
  background: #d84d35;
  font-size: 27rpx;
  font-weight: 900;
  line-height: 62rpx;
}

.dish-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.dish-card {
  min-width: 0;
  padding: 14rpx;
  border: 1rpx solid #e6dbcd;
  border-radius: 8rpx;
  background: #fffdf8;
}

.dish-cover {
  width: 100%;
  height: 190rpx;
  border-radius: 8rpx;
  background: #eee6dc;
}

.dish-title {
  display: block;
  margin-top: 14rpx;
  color: #241f1b;
  font-size: 29rpx;
  font-weight: 900;
  line-height: 38rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dish-meta {
  display: block;
  margin-top: 6rpx;
  color: #716a61;
  font-size: 24rpx;
  line-height: 32rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
