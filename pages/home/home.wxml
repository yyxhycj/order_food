<view class="home-page">
  <view class="top">
    <view class="brand">
      <text class="title">烟火小馆</text>
      <text class="subtitle">今日开饭 · {{menuSummary}}</text>
    </view>
    <button class="create-button" bindtap="goToCreate">+</button>
  </view>

  <view class="search">
    <input class="search-input" placeholder="搜菜名、食材、口味" value="{{keyword}}" bindinput="onKeywordInput" confirm-type="search" bindconfirm="onSearch" />
    <button wx:if="{{keyword}}" class="clear" bindtap="clearSearch">×</button>
    <button class="search-button" bindtap="onSearch">找</button>
  </view>

  <scroll-view class="categories" scroll-x="true" show-scrollbar="false">
    <block wx:for="{{categories}}" wx:key="_id">
      <view class="category {{currentCategoryId === item._id ? 'active' : ''}}" data-id="{{item._id}}" bindtap="selectCategory">
        {{item.name}}
      </view>
    </block>
  </scroll-view>

  <loading-state wx:if="{{loading}}" text="正在打开菜单"></loading-state>

  <view wx:else class="menu-list">
    <block wx:if="{{featuredRecipe}}">
      <view class="section-head">
        <text class="section-title">今日推荐</text>
        <text class="section-action" bindtap="goToPlan">去安排</text>
      </view>

      <view class="featured-card" data-id="{{featuredRecipe._id}}" bindtap="goToRecipe">
        <image class="featured-cover" src="{{featuredRecipe.coverImage || '/images/dish-placeholder.png'}}" mode="aspectFill"></image>
        <view class="featured-body">
          <text class="featured-title">{{featuredRecipe.title}}</text>
          <text class="featured-meta">{{featuredRecipe.featureLine}}</text>
          <view class="tag-row">
            <text wx:for="{{featuredRecipe.menuTags}}" wx:key="*this" class="food-tag {{index === 0 ? 'warm' : 'fresh'}}">{{item}}</text>
          </view>
          <button class="want-button" catchtap="goToRecipe" data-id="{{featuredRecipe._id}}">想吃</button>
        </view>
      </view>

      <view class="section-head">
        <text class="section-title">常点菜单</text>
        <text class="section-action" bindtap="showAllRecipes">全部菜</text>
      </view>

      <view class="dish-grid">
        <view class="dish-card" wx:for="{{menuRecipes}}" wx:key="_id" data-id="{{item._id}}" bindtap="goToRecipe">
          <image class="dish-cover" src="{{item.coverImage || '/images/dish-placeholder.png'}}" mode="aspectFill"></image>
          <text class="dish-title">{{item.title}}</text>
          <text class="dish-meta">{{item.menuLine}}</text>
        </view>
      </view>
    </block>
    <empty-state wx:else title="菜单还是空的" description="先放一道家里常吃的菜，之后就可以点了。" button-text="加一道菜" bind:action="goToCreate"></empty-state>
  </view>
</view>
