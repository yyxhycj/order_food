<!--pages/orders/orders.wxml-->
<view class="container">
  <!-- 请求列表 -->
  <scroll-view class="order-list" scroll-y="true" wx:if="{{requests.length > 0}}">
    <view class="order-item" wx:for="{{requests}}" wx:key="requestNo" bindtap="goToRequestDetail" data-request-no="{{item.requestNo}}">
      <view class="order-header">
        <text class="order-no">请求号: {{item.requestNo}}</text>
        <text class="order-status {{item.status}}">{{statusText[item.status]}}</text>
      </view>
      
      <view class="order-products">
        <view class="product-item" wx:for="{{item.items}}" wx:key="dishId" wx:for-item="dish">
          <text class="product-name">{{dish.name}}</text>
          <text class="product-info">x{{dish.quantity}}</text>
        </view>
      </view>
      
      <view class="order-footer">
        <view class="order-info">
          <text class="order-time">{{item.createTime}}</text>
          <text class="request-reason">原因: {{item.requestReason || '无'}}</text>
          <text class="urgency">紧急度: {{item.urgency === 'high' ? '紧急' : item.urgency === 'low' ? '一般' : '普通'}}</text>
        </view>
        <view class="order-total">
          <text class="total-text">共{{item.totalQuantity}}项</text>
        </view>
      </view>
    </view>
  </scroll-view>

  <!-- 空状态 -->
  <view class="empty-orders" wx:else>
    <image src="/images/empty-orders.png" class="empty-image"></image>
    <text class="empty-text">暂无请求记录</text>
    <text class="empty-desc">快去表达一些想法吧</text>
    <button class="go-shopping-btn" bindtap="goToMenu">去看看</button>
  </view>
</view> 