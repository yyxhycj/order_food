/* pages/blind-box/themes/themes.wxss */
.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 20rpx;
}

/* 页面标题 */
.page-header {
  text-align: center;
  margin-bottom: 40rpx;
  padding: 40rpx 20rpx;
}

.title {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 20rpx;
}

.subtitle {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  line-height: 1.4;
}

/* 主题网格 */
.themes-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.theme-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 30rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.theme-card:active {
  transform: scale(0.95);
}

.theme-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(45deg, transparent, rgba(255, 255, 255, 0.1));
  opacity: 0;
  transition: opacity 0.3s ease;
}

.theme-card:hover::before {
  opacity: 1;
}

.theme-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}

.theme-icon .icon {
  font-size: 40rpx;
}

.theme-info {
  flex: 1;
}

.theme-name {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 10rpx;
}

.theme-description {
  display: block;
  font-size: 24rpx;
  color: #666666;
  line-height: 1.4;
}

.theme-badge {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  background: #ff6b6b;
  color: #ffffff;
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
  font-size: 20rpx;
}

.badge-text {
  font-size: 20rpx;
  font-weight: 500;
}

/* 自定义设置 */
.custom-settings {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
}

.section-title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 30rpx;
}

.setting-item {
  margin-bottom: 40rpx;
}

.setting-item:last-child {
  margin-bottom: 0;
}

.setting-label {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
  margin-bottom: 20rpx;
}

/* 数量选择器 */
.quantity-selector {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
}

.quantity-btn {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: #f0f0f0;
  border: none;
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  display: flex;
  align-items: center;
  justify-content: center;
}

.quantity-btn:active {
  background: #e0e0e0;
}

.quantity-text {
  font-size: 36rpx;
  font-weight: 600;
  color: #333333;
  min-width: 80rpx;
  text-align: center;
}

/* 饮食限制标签 */
.restriction-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.restriction-tag {
  padding: 12rpx 24rpx;
  background: #f5f5f5;
  border-radius: 32rpx;
  font-size: 24rpx;
  color: #666666;
  transition: all 0.3s ease;
}

.restriction-tag.selected {
  background: #667eea;
  color: #ffffff;
}

.restriction-tag:active {
  transform: scale(0.95);
}

/* 预算选择器 */
.budget-selector {
  display: flex;
  gap: 16rpx;
}

.budget-option {
  flex: 1;
  padding: 20rpx;
  background: #f5f5f5;
  border-radius: 16rpx;
  text-align: center;
  font-size: 26rpx;
  color: #666666;
  transition: all 0.3s ease;
}

.budget-option.selected {
  background: #667eea;
  color: #ffffff;
}

.budget-option:active {
  transform: scale(0.95);
}

/* 按钮样式 */
.preview-section, .generate-section {
  margin-bottom: 30rpx;
}

.preview-btn, .generate-btn {
  width: 100%;
  height: 88rpx;
  border-radius: 44rpx;
  border: none;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.preview-btn {
  background: rgba(255, 255, 255, 0.2);
  color: #ffffff;
  border: 2rpx solid rgba(255, 255, 255, 0.3);
}

.preview-btn:active {
  background: rgba(255, 255, 255, 0.1);
}

.generate-btn.primary {
  background: #ffffff;
  color: #667eea;
}

.generate-btn.primary:active {
  background: #f0f0f0;
}

.generate-btn:disabled {
  background: rgba(255, 255, 255, 0.5);
  color: rgba(102, 126, 234, 0.5);
}

/* 预览弹窗 */
.preview-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  padding: 40rpx;
}

.modal-content {
  background: #ffffff;
  border-radius: 24rpx;
  width: 100%;
  max-width: 600rpx;
  max-height: 80vh;
  overflow: hidden;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.modal-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333333;
}

.modal-close {
  font-size: 48rpx;
  color: #999999;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-body {
  padding: 30rpx;
  max-height: 60vh;
  overflow-y: auto;
}

.preview-theme {
  margin-bottom: 30rpx;
}

.preview-theme-name {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 10rpx;
}

.preview-theme-desc {
  display: block;
  font-size: 24rpx;
  color: #666666;
  line-height: 1.4;
}

.preview-subtitle {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
  margin-bottom: 20rpx;
}

.recipe-preview-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.recipe-preview-item {
  width: calc(50% - 10rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.recipe-preview-image {
  width: 100rpx;
  height: 100rpx;
  border-radius: 16rpx;
  margin-bottom: 10rpx;
}

.recipe-preview-name {
  font-size: 24rpx;
  color: #333333;
  text-align: center;
  line-height: 1.2;
}

.modal-footer {
  display: flex;
  gap: 20rpx;
  padding: 30rpx;
  border-top: 1rpx solid #f0f0f0;
}

.modal-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 16rpx;
  border: none;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-btn.secondary {
  background: #f5f5f5;
  color: #666666;
}

.modal-btn.primary {
  background: #667eea;
  color: #ffffff;
}

.modal-btn:active {
  opacity: 0.8;
}

/* 加载覆盖层 */
.loading-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2000;
}

.loading-content {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 30rpx;
}

.loading-icon {
  width: 80rpx;
  height: 80rpx;
}

.loading-text {
  font-size: 28rpx;
  color: #333333;
  text-align: center;
}

/* 响应式设计 */
@media (max-width: 400px) {
  .themes-grid {
    grid-template-columns: 1fr;
  }
  
  .theme-card {
    padding: 20rpx;
  }
  
  .custom-settings {
    padding: 20rpx;
  }
} 