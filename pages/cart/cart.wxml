<!--pages/cart/cart.wxml-->
<view class="container">
  <!-- 愿望清单 -->
  <scroll-view class="wishlist" scroll-y="true" wx:if="{{wishList.length > 0}}">
    <view class="wish-item" wx:for="{{wishList}}" wx:key="id">
      <image src="{{item.image}}" class="dish-image"></image>
      <view class="dish-info">
        <text class="dish-name">{{item.dish_name || item.name}}</text>
        <text class="dish-desc">{{item.description}}</text>
        <view class="dish-bottom">
          <view class="quantity-control">
            <view class="quantity-btn" bindtap="decreaseQuantity" data-id="{{item.id}}">-</view>
            <text class="quantity-text">{{item.quantity}}</text>
            <view class="quantity-btn" bindtap="increaseQuantity" data-id="{{item.id}}">+</view>
          </view>
        </view>
      </view>
      <view class="delete-btn" bindtap="removeItem" data-id="{{item.id}}">
        <image src="/images/delete.png" class="delete-icon"></image>
      </view>
    </view>
  </scroll-view>

  <!-- 空愿望清单状态 -->
  <view class="empty-wishlist" wx:else>
    <image src="/images/empty-cart.png" class="empty-image"></image>
    <text class="empty-text">还没有想吃的菜品</text>
    <text class="empty-desc">快去看看有什么好吃的吧</text>
    <button class="go-browse-btn" bindtap="goToMenu">去看看</button>
  </view>

  <!-- 底部请求栏 -->
  <view class="request-bar" wx:if="{{wishList.length > 0}}">
    <view class="total-info">
      <text class="total-text">共选择{{totalQuantity}}个菜品</text>
    </view>
    <button class="request-btn" bindtap="goToRequest">提交请求</button>
  </view>
</view> 