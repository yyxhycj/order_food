/* pages/plans/list/list.wxss */
.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* 搜索栏 */
.search-bar {
  background: #fff;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.search-input {
  position: relative;
  background: #f8f8f8;
  border-radius: 8rpx;
  padding: 0 50rpx 0 20rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
}

.search-input input {
  flex: 1;
  height: 100%;
  font-size: 28rpx;
  color: #333;
}

.search-icon {
  position: absolute;
  right: 20rpx;
  width: 32rpx;
  height: 32rpx;
  opacity: 0.6;
}

/* 筛选栏 */
.filter-bar {
  background: #fff;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  padding: 20rpx;
  display: flex;
  justify-content: space-between;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.filter-item {
  display: flex;
  align-items: center;
  background: #f8f8f8;
  border-radius: 8rpx;
  padding: 12rpx 20rpx;
  flex: 1;
  margin: 0 10rpx;
}

.filter-item:first-child {
  margin-left: 0;
}

.filter-item:last-child {
  margin-right: 0;
}

.filter-label {
  font-size: 24rpx;
  color: #666;
  margin-right: 10rpx;
}

.filter-value {
  font-size: 26rpx;
  color: #333;
}

/* 章节 */
.section {
  margin-bottom: 30rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.section-more {
  font-size: 24rpx;
  color: #FF6B6B;
  padding: 8rpx 16rpx;
  background: rgba(255, 107, 107, 0.1);
  border-radius: 20rpx;
}

/* 热门推荐 */
.trending-scroll {
  white-space: nowrap;
}

.trending-list {
  display: inline-flex;
  padding-bottom: 10rpx;
}

.trending-item {
  display: inline-block;
  width: 200rpx;
  margin-right: 20rpx;
  background: #fff;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.trending-item:last-child {
  margin-right: 0;
}

.trending-image {
  position: relative;
  width: 100%;
  height: 120rpx;
}

.trending-cover {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.trending-badge {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  background: linear-gradient(135deg, #FF6B6B, #FF8E8E);
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 8rpx;
  border-radius: 8rpx;
  font-weight: 600;
}

.trending-info {
  padding: 12rpx;
}

.trending-name {
  font-size: 24rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 6rpx;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.trending-goal {
  font-size: 20rpx;
  color: #666;
  margin-bottom: 8rpx;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.trending-stats {
  display: flex;
  justify-content: space-between;
}

.trending-stat {
  font-size: 18rpx;
  color: #999;
}

/* 推荐列表 */
.recommended-list {
  background: #fff;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.recommended-item {
  padding: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.recommended-item:last-child {
  border-bottom: none;
}

.recommended-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.recommended-info {
  flex: 1;
}

.recommended-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
  display: block;
}

.recommended-description {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 12rpx;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recommended-meta {
  display: flex;
  gap: 20rpx;
}

.meta-item {
  font-size: 22rpx;
  color: #999;
  background: #f8f8f8;
  padding: 6rpx 12rpx;
  border-radius: 6rpx;
}

.recommended-creator {
  display: flex;
  align-items: center;
  margin-left: 20rpx;
}

.creator-avatar {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  margin-right: 8rpx;
}

.creator-name {
  font-size: 22rpx;
  color: #666;
}

/* 计划列表 */
.plan-list {
  background: #fff;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.plan-item {
  padding: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.plan-item:last-child {
  border-bottom: none;
}

.plan-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 12rpx;
}

.plan-basic-info {
  flex: 1;
}

.plan-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 6rpx;
  display: block;
}

.plan-goal {
  font-size: 24rpx;
  color: #666;
  display: block;
}

.plan-difficulty {
  margin-left: 20rpx;
}

.difficulty-badge {
  font-size: 20rpx;
  padding: 6rpx 12rpx;
  border-radius: 12rpx;
  font-weight: 600;
  color: #fff;
}

.difficulty-easy {
  background: #4CAF50;
}

.difficulty-medium {
  background: #FF9800;
}

.difficulty-hard {
  background: #F44336;
}

.plan-description {
  margin-bottom: 16rpx;
}

.description-text {
  font-size: 24rpx;
  color: #666;
  line-height: 1.6;
}

.plan-stats {
  display: flex;
  justify-content: space-between;
  margin-bottom: 16rpx;
  padding: 12rpx 0;
  border-top: 1rpx solid #f0f0f0;
  border-bottom: 1rpx solid #f0f0f0;
}

.stat-item {
  text-align: center;
  flex: 1;
}

.stat-label {
  font-size: 20rpx;
  color: #999;
  margin-bottom: 4rpx;
  display: block;
}

.stat-value {
  font-size: 24rpx;
  font-weight: 600;
  color: #333;
  display: block;
}

.plan-creator {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.plan-creator .creator-avatar {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  margin-right: 8rpx;
}

.plan-creator .creator-name {
  font-size: 22rpx;
  color: #666;
  margin-right: auto;
}

.create-time {
  font-size: 20rpx;
  color: #999;
}

/* 加载更多 */
.load-more {
  text-align: center;
  padding: 40rpx 0;
}

.load-more-text {
  font-size: 26rpx;
  color: #666;
  padding: 20rpx 40rpx;
  background: #fff;
  border-radius: 50rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 100rpx 40rpx;
  background: #fff;
  border-radius: 12rpx;
  margin-top: 40rpx;
}

.empty-image {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 20rpx;
  opacity: 0.6;
}

.empty-text {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 10rpx;
  display: block;
}

.empty-subtext {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 30rpx;
  display: block;
}

.create-plan-btn {
  background: linear-gradient(135deg, #FF6B6B, #FF8E8E);
  color: #fff;
  font-size: 26rpx;
  padding: 20rpx 40rpx;
  border-radius: 50rpx;
  border: none;
  font-weight: 600;
}

/* 加载中 */
.loading {
  text-align: center;
  padding: 40rpx 0;
}

.loading-spinner {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid #f3f3f3;
  border-top: 4rpx solid #FF6B6B;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin: 0 auto 20rpx;
}

.loading-text {
  font-size: 24rpx;
  color: #666;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

/* 悬浮创建按钮 */
.fab {
  position: fixed;
  bottom: 100rpx;
  right: 40rpx;
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #FF6B6B, #FF8E8E);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 107, 0.3);
  z-index: 1000;
}

.fab-icon {
  width: 48rpx;
  height: 48rpx;
  filter: brightness(0) invert(1);
}

/* 响应式设计 */
@media (max-width: 750rpx) {
  .filter-bar {
    flex-direction: column;
    gap: 10rpx;
  }
  
  .filter-item {
    margin: 0;
  }
  
  .plan-stats {
    flex-wrap: wrap;
    gap: 10rpx;
  }
  
  .stat-item {
    min-width: 40%;
  }
} 