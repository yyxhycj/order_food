<!-- 菜谱计划列表页面 -->
<view class="container">
  <!-- 搜索栏 -->
  <view class="search-bar">
    <view class="search-input">
      <input type="text" placeholder="搜索菜谱计划..." bindinput="onSearchInput" value="{{searchText}}" />
      <image src="/images/search.png" class="search-icon" />
    </view>
  </view>

  <!-- 筛选栏 -->
  <view class="filter-bar">
    <view class="filter-item">
      <text class="filter-label">难度:</text>
      <picker range="{{difficultyOptions}}" range-key="text" bindchange="onDifficultyChange">
        <view class="filter-value">{{difficultyOptions[difficultyIndex].text}}</view>
      </picker>
    </view>
    <view class="filter-item">
      <text class="filter-label">排序:</text>
      <picker range="{{sortOptions}}" range-key="text" bindchange="onSortChange">
        <view class="filter-value">{{sortOptions[sortIndex].text}}</view>
      </picker>
    </view>
  </view>

  <!-- 热门推荐 -->
  <view class="section" wx:if="{{trendingPlans.length > 0}}">
    <view class="section-header">
      <text class="section-title">🔥 热门计划</text>
      <text class="section-more" bindtap="showAllTrending">查看全部</text>
    </view>
    <scroll-view scroll-x="true" class="trending-scroll">
      <view class="trending-list">
        <view class="trending-item" wx:for="{{trendingPlans}}" wx:key="id" bindtap="viewPlan" data-id="{{item.id}}">
          <view class="trending-image">
            <image src="{{item.cover_image || '/images/default-plan.png'}}" class="trending-cover" />
            <view class="trending-badge">TOP {{index + 1}}</view>
          </view>
          <view class="trending-info">
            <text class="trending-name">{{item.name}}</text>
            <text class="trending-goal">{{item.target_goal}}</text>
            <view class="trending-stats">
              <text class="trending-stat">{{item.follower_count}}人跟随</text>
              <text class="trending-stat">{{item.duration_days}}天</text>
            </view>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 个性化推荐 -->
  <view class="section" wx:if="{{recommendedPlans.length > 0}}">
    <view class="section-header">
      <text class="section-title">💡 为你推荐</text>
    </view>
    <view class="recommended-list">
      <view class="recommended-item" wx:for="{{recommendedPlans}}" wx:key="id" bindtap="viewPlan" data-id="{{item.id}}">
        <view class="recommended-content">
          <view class="recommended-info">
            <text class="recommended-name">{{item.name}}</text>
            <text class="recommended-description">{{item.description}}</text>
            <view class="recommended-meta">
              <text class="meta-item">{{item.duration_days}}天</text>
              <text class="meta-item">{{item.difficulty_level}}</text>
              <text class="meta-item">{{item.recipe_count}}道菜谱</text>
            </view>
          </view>
          <view class="recommended-creator">
            <image src="{{item.creator_avatar || '/images/default-avatar.png'}}" class="creator-avatar" />
            <text class="creator-name">{{item.creator_name}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 所有计划 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">📋 所有计划</text>
    </view>
    
    <!-- 计划列表 -->
    <view class="plan-list">
      <view class="plan-item" wx:for="{{planList}}" wx:key="id" bindtap="viewPlan" data-id="{{item.id}}">
        <view class="plan-header">
          <view class="plan-basic-info">
            <text class="plan-name">{{item.name}}</text>
            <text class="plan-goal">目标：{{item.target_goal}}</text>
          </view>
          <view class="plan-difficulty">
            <text class="difficulty-badge difficulty-{{item.difficulty_level}}">{{item.difficulty_level}}</text>
          </view>
        </view>
        
        <view class="plan-description">
          <text class="description-text">{{item.description}}</text>
        </view>
        
        <view class="plan-stats">
          <view class="stat-item">
            <text class="stat-label">时长</text>
            <text class="stat-value">{{item.duration_days}}天</text>
          </view>
          <view class="stat-item">
            <text class="stat-label">菜谱</text>
            <text class="stat-value">{{item.current_recipe_count}}道</text>
          </view>
          <view class="stat-item">
            <text class="stat-label">跟随者</text>
            <text class="stat-value">{{item.follower_count}}</text>
          </view>
          <view class="stat-item">
            <text class="stat-label">完成率</text>
            <text class="stat-value">{{item.completion_rate}}%</text>
          </view>
        </view>
        
        <view class="plan-creator">
          <image src="{{item.creator_avatar || '/images/default-avatar.png'}}" class="creator-avatar" />
          <text class="creator-name">{{item.creator_name}}</text>
          <text class="create-time">{{item.created_at}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 加载更多 -->
  <view class="load-more" wx:if="{{hasMore}}">
    <view class="load-more-text" bindtap="loadMore">加载更多</view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{planList.length === 0 && !loading}}">
    <image src="/images/empty-plans.png" class="empty-image" />
    <text class="empty-text">暂无菜谱计划</text>
    <text class="empty-subtext">快来创建第一个计划吧！</text>
    <button class="create-plan-btn" bindtap="createPlan">创建计划</button>
  </view>

  <!-- 加载中 -->
  <view class="loading" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>
</view>

<!-- 创建计划按钮 -->
<view class="fab" bindtap="createPlan">
  <image src="/images/add.png" class="fab-icon" />
</view> 