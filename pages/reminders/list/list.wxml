<!--pages/reminders/list/list.wxml-->
<view class="reminder-container">
  <!-- 页面标题和操作区 -->
  <view class="header">
    <view class="title">
      <text class="title-text">订单提醒</text>
      <text class="unread-count" wx:if="{{unreadCount > 0}}">({{unreadCount}})</text>
    </view>
    <button 
      class="mark-all-btn" 
      wx:if="{{unreadCount > 0}}"
      bindtap="markAllAsRead">
      全部已读
    </button>
  </view>

  <!-- 加载状态 -->
  <view class="loading" wx:if="{{loading && reminders.length === 0}}">
    <text>加载中...</text>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{!loading && reminders.length === 0}}">
    <image class="empty-icon" src="/images/empty.png"></image>
    <text class="empty-text">暂无提醒消息</text>
  </view>

  <!-- 提醒列表 -->
  <view class="reminder-list" wx:if="{{reminders.length > 0}}">
    <view 
      class="reminder-item {{item.status === 'read' ? 'read' : 'unread'}}"
      wx:for="{{reminders}}" 
      wx:key="id"
      wx:for-index="index"
      wx:for-item="item">
      
      <!-- 提醒头部 -->
      <view class="reminder-header">
        <view class="reminder-type">
          <text class="type-icon">🔔</text>
          <text class="type-text">新订单提醒</text>
        </view>
        <view class="reminder-time">
          <text class="time-text">{{item.timeAgo}}</text>
        </view>
      </view>

      <!-- 提醒内容 -->
      <view class="reminder-content" bindtap="goToOrderDetail" data-order-id="{{item.order_id}}">
        <text class="message">{{item.message}}</text>
        <view class="order-info" wx:if="{{item.request_no}}">
          <text class="order-no">订单号: {{item.request_no}}</text>
          <text class="customer-name" wx:if="{{item.user_name}}">客户: {{item.user_name}}</text>
        </view>
      </view>

      <!-- 操作按钮 -->
      <view class="reminder-actions" wx:if="{{item.status !== 'read'}}">
        <button 
          class="mark-read-btn" 
          size="mini"
          bindtap="markAsRead" 
          data-id="{{item.id}}" 
          data-index="{{index}}">
          标记已读
        </button>
      </view>
    </view>
  </view>

  <!-- 加载更多提示 -->
  <view class="load-more" wx:if="{{loading && reminders.length > 0}}">
    <text>加载中...</text>
  </view>

  <view class="no-more" wx:if="{{!hasMore && reminders.length > 0}}">
    <text>没有更多了</text>
  </view>
</view>