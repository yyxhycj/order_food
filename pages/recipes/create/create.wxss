/* 菜谱创建页面样式 */
.recipe-create {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 120rpx;
}

/* 步骤导航 */
.steps-nav {
  display: flex;
  background: #fff;
  padding: 30rpx;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.step-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  flex: 1;
}

.step-number {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  background: #e0e0e0;
  color: #999;
  font-size: 24rpx;
  font-weight: bold;
}

.step-item.active .step-number {
  background: #1890ff;
  color: #fff;
}

.step-text {
  font-size: 24rpx;
  color: #666;
}

.step-item.active .step-text {
  color: #1890ff;
}

/* 步骤内容 */
.step-content {
  padding: 30rpx;
}

.form-section {
  background: #fff;
  border-radius: 10rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 30rpx;
}

/* 表单项 */
.form-item {
  margin-bottom: 40rpx;
}

.form-label {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 15rpx;
  display: block;
}

.required {
  color: #ff4d4f;
}

.form-input {
  width: 100%;
  height: 80rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-input:focus {
  border-color: #1890ff;
}

.form-textarea {
  width: 100%;
  min-height: 150rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 8rpx;
  padding: 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-textarea:focus {
  border-color: #1890ff;
}

.form-picker {
  width: 100%;
  height: 80rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  box-sizing: border-box;
}

.picker-value {
  font-size: 28rpx;
  color: #333;
}

/* 图片上传 */
.image-upload {
  position: relative;
}

.main-image {
  width: 100%;
  height: 400rpx;
  border-radius: 10rpx;
}

.upload-placeholder {
  width: 100%;
  height: 400rpx;
  border: 2rpx dashed #ccc;
  border-radius: 10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  background: #fafafa;
}

.upload-placeholder.small {
  height: 200rpx;
}

.upload-icon {
  width: 60rpx;
  height: 60rpx;
  opacity: 0.5;
}

.upload-text {
  font-size: 26rpx;
  color: #999;
}

.image-actions {
  position: absolute;
  bottom: 20rpx;
  right: 20rpx;
  display: flex;
  gap: 10rpx;
}

.action-btn {
  padding: 10rpx 20rpx;
  font-size: 24rpx;
  border-radius: 20rpx;
  background: rgba(0, 0, 0, 0.6);
  color: #fff;
  border: none;
  margin: 0;
}

.action-btn.remove {
  background: #ff4d4f;
}

/* 难度选择 */
.difficulty-options {
  display: flex;
  gap: 20rpx;
}

.difficulty-option {
  flex: 1;
  height: 60rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
}

.difficulty-option.selected {
  border-color: #1890ff;
  background: #e6f7ff;
}

.difficulty-text {
  font-size: 26rpx;
  color: #333;
}

.difficulty-option.selected .difficulty-text {
  color: #1890ff;
}

/* 季节标签 */
.season-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
}

.season-tag {
  padding: 15rpx 25rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #666;
  cursor: pointer;
}

.season-tag.selected {
  border-color: #1890ff;
  background: #e6f7ff;
  color: #1890ff;
}

/* 食材列表 */
.ingredients-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.ingredient-item {
  display: flex;
  align-items: center;
  gap: 15rpx;
  padding: 20rpx;
  background: #f8f9fa;
  border-radius: 10rpx;
}

.ingredient-number {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  background: #1890ff;
  color: #fff;
  border-radius: 50%;
  font-size: 22rpx;
  font-weight: bold;
  flex-shrink: 0;
}

.ingredient-inputs {
  display: flex;
  flex: 1;
  gap: 15rpx;
}

.ingredient-name {
  flex: 2;
  height: 60rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 8rpx;
  padding: 0 15rpx;
  font-size: 26rpx;
  box-sizing: border-box;
}

.ingredient-amount {
  flex: 1;
  height: 60rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 8rpx;
  padding: 0 15rpx;
  font-size: 26rpx;
  box-sizing: border-box;
}

.ingredient-actions {
  flex-shrink: 0;
}

.remove-btn {
  padding: 10rpx 20rpx;
  font-size: 22rpx;
  border-radius: 15rpx;
  background: #ff4d4f;
  color: #fff;
  border: none;
  margin: 0;
}

/* 添加按钮 */
.add-ingredient, .add-step {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 30rpx;
  border: 2rpx dashed #ccc;
  border-radius: 10rpx;
  background: #fafafa;
  cursor: pointer;
  margin-top: 20rpx;
}

.add-icon {
  width: 30rpx;
  height: 30rpx;
  opacity: 0.5;
}

.add-text {
  font-size: 26rpx;
  color: #999;
}

/* 推荐食材 */
.recommend-ingredients {
  margin-top: 30rpx;
}

.recommend-title {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 15rpx;
}

.recommend-list {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
}

.recommend-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 15rpx 20rpx;
  background: #e6f7ff;
  border-radius: 20rpx;
  cursor: pointer;
}

.recommend-name {
  font-size: 24rpx;
  color: #1890ff;
}

.recommend-amount {
  font-size: 22rpx;
  color: #666;
}

/* 制作步骤 */
.steps-list {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.step-item {
  display: flex;
  gap: 20rpx;
  align-items: flex-start;
  padding: 20rpx;
  background: #f8f9fa;
  border-radius: 10rpx;
}

.step-content {
  flex: 1;
}

.step-description {
  width: 100%;
  min-height: 120rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 8rpx;
  padding: 15rpx;
  font-size: 26rpx;
  box-sizing: border-box;
  margin-bottom: 20rpx;
}

.step-image-upload {
  position: relative;
}

.step-image {
  width: 100%;
  height: 200rpx;
  border-radius: 10rpx;
}

.step-actions {
  flex-shrink: 0;
}

/* 视频上传 */
.video-upload {
  margin-top: 30rpx;
}

.video-preview {
  position: relative;
}

.recipe-video {
  width: 100%;
  height: 400rpx;
  border-radius: 10rpx;
}

.video-actions {
  position: absolute;
  bottom: 20rpx;
  right: 20rpx;
  display: flex;
  gap: 10rpx;
}

/* 营养信息 */
.nutrition-inputs {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.nutrition-item {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.nutrition-label {
  font-size: 24rpx;
  color: #666;
}

.nutrition-input {
  height: 60rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 8rpx;
  padding: 0 15rpx;
  font-size: 26rpx;
  box-sizing: border-box;
}

/* 发布设置 */
.publish-settings {
  margin-top: 30rpx;
}

.setting-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx;
  background: #f8f9fa;
  border-radius: 10rpx;
}

.setting-label {
  font-size: 26rpx;
  color: #333;
}

.setting-switch {
  transform: scale(0.8);
}

.setting-desc {
  font-size: 24rpx;
  color: #666;
}

/* 预览区域 */
.preview-section {
  margin-top: 30rpx;
}

.preview-title {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 15rpx;
}

.recipe-preview {
  display: flex;
  gap: 20rpx;
  padding: 20rpx;
  background: #f8f9fa;
  border-radius: 10rpx;
}

.preview-image {
  width: 150rpx;
  height: 150rpx;
  border-radius: 10rpx;
  flex-shrink: 0;
}

.preview-info {
  flex: 1;
}

.preview-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 10rpx;
}

.preview-meta {
  display: flex;
  gap: 20rpx;
  margin-bottom: 10rpx;
}

.preview-time, .preview-difficulty {
  font-size: 24rpx;
  color: #666;
}

.preview-desc {
  font-size: 24rpx;
  color: #666;
  line-height: 1.4;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background: #fff;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 30rpx;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.nav-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  line-height: 80rpx;
  text-align: center;
  margin: 0;
  padding: 0;
}

.nav-btn.secondary {
  background: #f0f0f0;
  color: #666;
}

.nav-btn.primary {
  background: #1890ff;
  color: #fff;
}

.nav-btn.secondary::after {
  border: none;
}

.nav-btn.primary::after {
  border: none;
}

/* 响应式适配 */
@media (max-width: 375px) {
  .ingredient-inputs {
    flex-direction: column;
    gap: 10rpx;
  }
  
  .ingredient-name, .ingredient-amount {
    flex: 1;
  }
  
  .nutrition-inputs {
    grid-template-columns: 1fr;
  }
  
  .recipe-preview {
    flex-direction: column;
  }
  
  .preview-image {
    width: 100%;
    height: 200rpx;
  }
} 