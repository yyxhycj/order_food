<view class="recipe-generator">
  <!-- 页面标题 -->
  <view class="page-header">
    <view class="header-title">智能菜谱生成</view>
    <view class="header-subtitle">输入食材，AI为您生成美味菜谱</view>
  </view>

  <!-- 生成方式选择 -->
  <view class="generation-mode">
    <view class="mode-title">生成方式</view>
    <view class="mode-options">
      <view class="mode-option {{generationMode === 'ingredients' ? 'selected' : ''}}" bindtap="switchMode" data-mode="ingredients">
        <image class="mode-icon" src="/images/ingredients.png"></image>
        <text class="mode-text">食材生成</text>
      </view>
      <view class="mode-option {{generationMode === 'theme' ? 'selected' : ''}}" bindtap="switchMode" data-mode="theme">
        <image class="mode-icon" src="/images/theme.png"></image>
        <text class="mode-text">主题生成</text>
      </view>
      <view class="mode-option {{generationMode === 'preference' ? 'selected' : ''}}" bindtap="switchMode" data-mode="preference">
        <image class="mode-icon" src="/images/preference.png"></image>
        <text class="mode-text">偏好生成</text>
      </view>
    </view>
  </view>

  <!-- 食材输入模式 -->
  <view class="input-section" wx:if="{{generationMode === 'ingredients'}}">
    <view class="section-title">现有食材</view>
    <view class="ingredients-input">
      <view class="input-methods">
        <button class="input-method-btn {{inputMethod === 'manual' ? 'active' : ''}}" bindtap="switchInputMethod" data-method="manual">手动输入</button>
        <button class="input-method-btn {{inputMethod === 'voice' ? 'active' : ''}}" bindtap="switchInputMethod" data-method="voice">语音输入</button>
        <button class="input-method-btn {{inputMethod === 'scan' ? 'active' : ''}}" bindtap="switchInputMethod" data-method="scan">扫描识别</button>
      </view>
      
      <!-- 手动输入 -->
      <view class="manual-input" wx:if="{{inputMethod === 'manual'}}">
        <view class="ingredient-tags">
          <block wx:for="{{selectedIngredients}}" wx:key="*this">
            <view class="ingredient-tag">
              <text class="tag-text">{{item}}</text>
              <view class="tag-remove" bindtap="removeIngredient" data-ingredient="{{item}}">×</view>
            </view>
          </block>
        </view>
        <view class="input-container">
          <input class="ingredient-input" placeholder="输入食材名称，如：鸡蛋、西红柿" value="{{currentIngredient}}" bindinput="onIngredientInput" bindconfirm="addIngredient"/>
          <button class="add-btn" bindtap="addIngredient">添加</button>
        </view>
      </view>
      
      <!-- 语音输入 -->
      <view class="voice-input" wx:if="{{inputMethod === 'voice'}}">
        <view class="voice-container">
          <button class="voice-btn {{isListening ? 'listening' : ''}}" bindtap="toggleVoiceInput">
            <image class="voice-icon" src="/images/microphone.png"></image>
            <text class="voice-text">{{isListening ? '正在听...' : '点击说话'}}</text>
          </button>
          <view class="voice-result" wx:if="{{voiceResult}}">
            <text class="result-text">识别结果：{{voiceResult}}</text>
            <button class="confirm-btn" bindtap="confirmVoiceInput">确认添加</button>
          </view>
        </view>
      </view>
      
      <!-- 扫描识别 -->
      <view class="scan-input" wx:if="{{inputMethod === 'scan'}}">
        <view class="scan-container">
          <button class="scan-btn" bindtap="scanIngredients">
            <image class="scan-icon" src="/images/camera.png"></image>
            <text class="scan-text">拍照识别食材</text>
          </button>
          <view class="scan-tip">对准冰箱或食材拍照，AI将自动识别食材类型</view>
        </view>
      </view>
    </view>
    
    <!-- 推荐食材 -->
    <view class="recommend-section" wx:if="{{recommendIngredients.length > 0}}">
      <view class="recommend-title">推荐食材</view>
      <view class="recommend-grid">
        <block wx:for="{{recommendIngredients}}" wx:key="*this">
          <view class="recommend-item" bindtap="selectRecommendIngredient" data-ingredient="{{item}}">
            <image class="recommend-icon" src="/images/ingredients/{{item}}.png"></image>
            <text class="recommend-name">{{item}}</text>
          </view>
        </block>
      </view>
    </view>
  </view>

  <!-- 主题生成模式 -->
  <view class="input-section" wx:if="{{generationMode === 'theme'}}">
    <view class="section-title">选择主题</view>
    <view class="theme-categories">
      <view class="category-item" wx:for="{{themeCategories}}" wx:key="id" bindtap="selectThemeCategory" data-category="{{item}}">
        <image class="category-icon" src="{{item.icon}}"></image>
        <text class="category-name">{{item.name}}</text>
      </view>
    </view>
    
    <view class="theme-options" wx:if="{{selectedThemeCategory}}">
      <view class="options-title">{{selectedThemeCategory.name}}主题</view>
      <view class="options-grid">
        <block wx:for="{{themeOptions}}" wx:key="id">
          <view class="theme-option {{selectedTheme === item.id ? 'selected' : ''}}" bindtap="selectTheme" data-theme="{{item}}">
            <image class="theme-image" src="{{item.image}}" mode="aspectFill"></image>
            <text class="theme-name">{{item.name}}</text>
          </view>
        </block>
      </view>
    </view>
  </view>

  <!-- 偏好生成模式 -->
  <view class="input-section" wx:if="{{generationMode === 'preference'}}">
    <view class="section-title">您的偏好</view>
    
    <!-- 口味偏好 -->
    <view class="preference-item">
      <view class="preference-label">口味偏好</view>
      <view class="taste-options">
        <block wx:for="{{tasteOptions}}" wx:key="value">
          <view class="taste-option {{selectedTastes.includes(item.value) ? 'selected' : ''}}" bindtap="toggleTaste" data-taste="{{item.value}}">
            <text class="taste-text">{{item.label}}</text>
          </view>
        </block>
      </view>
    </view>
    
    <!-- 菜系偏好 -->
    <view class="preference-item">
      <view class="preference-label">菜系偏好</view>
      <view class="cuisine-options">
        <block wx:for="{{cuisineOptions}}" wx:key="value">
          <view class="cuisine-option {{selectedCuisines.includes(item.value) ? 'selected' : ''}}" bindtap="toggleCuisine" data-cuisine="{{item.value}}">
            <text class="cuisine-text">{{item.label}}</text>
          </view>
        </block>
      </view>
    </view>
    
    <!-- 制作时间 -->
    <view class="preference-item">
      <view class="preference-label">制作时间</view>
      <picker class="time-picker" mode="selector" range="{{timeRanges}}" range-key="label" bindchange="onTimeRangeChange">
        <view class="picker-value">{{selectedTimeRange || '请选择时间范围'}}</view>
      </picker>
    </view>
    
    <!-- 难度偏好 -->
    <view class="preference-item">
      <view class="preference-label">难度偏好</view>
      <view class="difficulty-slider">
        <slider class="slider" min="1" max="5" value="{{selectedDifficulty}}" bindchange="onDifficultyChange" show-value step="1" activeColor="#1890ff"/>
        <view class="difficulty-labels">
          <text class="label-item">简单</text>
          <text class="label-item">较易</text>
          <text class="label-item">中等</text>
          <text class="label-item">较难</text>
          <text class="label-item">困难</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 高级设置 -->
  <view class="advanced-settings">
    <view class="settings-title">高级设置</view>
    
    <!-- 营养需求 -->
    <view class="setting-item">
      <view class="setting-label">营养需求</view>
      <view class="nutrition-options">
        <block wx:for="{{nutritionOptions}}" wx:key="value">
          <view class="nutrition-option {{selectedNutrition.includes(item.value) ? 'selected' : ''}}" bindtap="toggleNutrition" data-nutrition="{{item.value}}">
            <text class="nutrition-text">{{item.label}}</text>
          </view>
        </block>
      </view>
    </view>
    
    <!-- 饮食限制 -->
    <view class="setting-item">
      <view class="setting-label">饮食限制</view>
      <view class="restriction-options">
        <block wx:for="{{restrictionOptions}}" wx:key="value">
          <view class="restriction-option {{selectedRestrictions.includes(item.value) ? 'selected' : ''}}" bindtap="toggleRestriction" data-restriction="{{item.value}}">
            <text class="restriction-text">{{item.label}}</text>
          </view>
        </block>
      </view>
    </view>
    
    <!-- 生成数量 -->
    <view class="setting-item">
      <view class="setting-label">生成数量</view>
      <view class="quantity-selector">
        <button class="quantity-btn {{generateQuantity === 1 ? 'selected' : ''}}" bindtap="setQuantity" data-quantity="1">1个</button>
        <button class="quantity-btn {{generateQuantity === 3 ? 'selected' : ''}}" bindtap="setQuantity" data-quantity="3">3个</button>
        <button class="quantity-btn {{generateQuantity === 5 ? 'selected' : ''}}" bindtap="setQuantity" data-quantity="5">5个</button>
      </view>
    </view>
  </view>

  <!-- 生成按钮 -->
  <view class="generate-section">
    <button class="generate-btn" bindtap="generateRecipes" disabled="{{!canGenerate || isGenerating}}">
      <text class="generate-text">{{isGenerating ? '生成中...' : '智能生成菜谱'}}</text>
    </button>
  </view>

  <!-- 生成结果 -->
  <view class="results-section" wx:if="{{generatedRecipes.length > 0}}">
    <view class="results-title">生成结果</view>
    <view class="recipes-grid">
      <block wx:for="{{generatedRecipes}}" wx:key="id">
        <view class="recipe-card" bindtap="viewRecipe" data-recipe="{{item}}">
          <image class="recipe-image" src="{{item.image || '/images/default-recipe.jpg'}}" mode="aspectFill"></image>
          <view class="recipe-info">
            <view class="recipe-name">{{item.name}}</view>
            <view class="recipe-meta">
              <text class="recipe-time">{{item.cookingTime}}分钟</text>
              <text class="recipe-difficulty">{{item.difficulty}}</text>
            </view>
            <view class="recipe-ingredients">
              <text class="ingredients-text">{{item.mainIngredients}}</text>
            </view>
          </view>
          <view class="recipe-actions">
            <button class="action-btn save" bindtap="saveRecipe" data-recipe="{{item}}">保存</button>
            <button class="action-btn share" bindtap="shareRecipe" data-recipe="{{item}}">分享</button>
          </view>
        </view>
      </block>
    </view>
    
    <!-- 重新生成按钮 -->
    <view class="regenerate-section">
      <button class="regenerate-btn" bindtap="regenerateRecipes">重新生成</button>
    </view>
  </view>

  <!-- 生成历史 -->
  <view class="history-section" wx:if="{{generateHistory.length > 0}}">
    <view class="history-title">生成历史</view>
    <view class="history-list">
      <block wx:for="{{generateHistory}}" wx:key="id">
        <view class="history-item" bindtap="viewHistory" data-history="{{item}}">
          <view class="history-info">
            <text class="history-mode">{{item.mode}}</text>
            <text class="history-time">{{item.time}}</text>
          </view>
          <view class="history-params">{{item.params}}</view>
        </view>
      </block>
    </view>
  </view>
</view> 