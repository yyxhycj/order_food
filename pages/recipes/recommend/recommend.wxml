<view class="recommend-container">
  <!-- 页面头部 -->
  <view class="page-header">
    <text class="page-title">个性化推荐</text>
    <text class="page-subtitle">根据您的口味偏好为您推荐</text>
  </view>

  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading-container">
    <text class="loading-text">AI正在分析您的口味偏好...</text>
    <view class="loading-dots">
      <view class="dot dot1"></view>
      <view class="dot dot2"></view>
      <view class="dot dot3"></view>
    </view>
  </view>

  <!-- 推荐概览 -->
  <view wx:if="{{!loading && recommendationSummary}}" class="recommendation-summary">
    <view class="summary-card">
      <text class="summary-title">今日推荐</text>
      <text class="summary-text">基于您的口味档案，我们为您精心挑选了{{recommendationSummary.totalCount}}道菜谱</text>
    </view>
  </view>

  <!-- 推荐分类 -->
  <view wx:if="{{!loading}}" class="recommendation-sections">
    
    <!-- 为您推荐 -->
    <view class="section" wx:if="{{personalizedRecipes.length > 0}}">
      <view class="section-header">
        <text class="section-title">为您推荐</text>
        <text class="section-subtitle">基于您的口味偏好</text>
      </view>
      <scroll-view class="recipe-scroll" scroll-x>
        <view class="recipe-list">
          <view class="recipe-card" wx:for="{{personalizedRecipes}}" wx:key="id" 
                data-id="{{item.id}}" bindtap="onRecipeClick">
            <image class="recipe-image" src="{{item.main_image || '/images/recipe-placeholder.png'}}" 
                   mode="aspectFill"></image>
            <view class="recipe-info">
              <text class="recipe-name">{{item.name}}</text>
              <view class="recipe-meta">
                <text class="meta-item">{{item.cooking_time}}分钟</text>
                <text class="meta-item">{{item.difficulty_text}}</text>
              </view>
              <view class="recipe-rating">
                <text class="rating-text">{{item.average_rating}}</text>
                <text class="rating-count">({{item.review_count}})</text>
              </view>
            </view>
            <view class="recommend-reason">
              <text class="reason-text">{{item.recommend_reason}}</text>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- 相似口味推荐 -->
    <view class="section" wx:if="{{similarTasteRecipes.length > 0}}">
      <view class="section-header">
        <text class="section-title">相似口味</text>
        <text class="section-subtitle">与您口味相似的用户也喜欢</text>
      </view>
      <scroll-view class="recipe-scroll" scroll-x>
        <view class="recipe-list">
          <view class="recipe-card" wx:for="{{similarTasteRecipes}}" wx:key="id" 
                data-id="{{item.id}}" bindtap="onRecipeClick">
            <image class="recipe-image" src="{{item.main_image || '/images/recipe-placeholder.png'}}" 
                   mode="aspectFill"></image>
            <view class="recipe-info">
              <text class="recipe-name">{{item.name}}</text>
              <view class="recipe-meta">
                <text class="meta-item">{{item.cooking_time}}分钟</text>
                <text class="meta-item">{{item.difficulty_text}}</text>
              </view>
              <view class="recipe-rating">
                <text class="rating-text">{{item.average_rating}}</text>
                <text class="rating-count">({{item.review_count}})</text>
              </view>
            </view>
            <view class="similarity-score">
              <text class="score-text">匹配度: {{item.similarity_score}}%</text>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- 热门推荐 -->
    <view class="section" wx:if="{{trendingRecipes.length > 0}}">
      <view class="section-header">
        <text class="section-title">热门推荐</text>
        <text class="section-subtitle">最受欢迎的菜谱</text>
      </view>
      <scroll-view class="recipe-scroll" scroll-x>
        <view class="recipe-list">
          <view class="recipe-card" wx:for="{{trendingRecipes}}" wx:key="id" 
                data-id="{{item.id}}" bindtap="onRecipeClick">
            <image class="recipe-image" src="{{item.main_image || '/images/recipe-placeholder.png'}}" 
                   mode="aspectFill"></image>
            <view class="recipe-info">
              <text class="recipe-name">{{item.name}}</text>
              <view class="recipe-meta">
                <text class="meta-item">{{item.cooking_time}}分钟</text>
                <text class="meta-item">{{item.difficulty_text}}</text>
              </view>
              <view class="recipe-rating">
                <text class="rating-text">{{item.average_rating}}</text>
                <text class="rating-count">({{item.review_count}})</text>
              </view>
            </view>
            <view class="trend-indicator">
              <text class="trend-text">🔥 热门</text>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>

  </view>

  <!-- 推荐设置 -->
  <view class="recommendation-settings">
    <view class="setting-header">
      <text class="setting-title">推荐设置</text>
    </view>
    <view class="setting-item" bindtap="onTasteProfileClick">
      <text class="setting-label">完善口味档案</text>
      <text class="setting-desc">让推荐更精准</text>
      <text class="setting-arrow">></text>
    </view>
    <view class="setting-item" bindtap="onTagsClick">
      <text class="setting-label">管理标签</text>
      <text class="setting-desc">自定义您的标签</text>
      <text class="setting-arrow">></text>
    </view>
    <view class="setting-item">
      <text class="setting-label">推荐频率</text>
      <picker range="{{frequencyOptions}}" value="{{selectedFrequency}}" 
              bindchange="onFrequencyChange">
        <view class="picker-value">{{frequencyOptions[selectedFrequency]}}</view>
      </picker>
    </view>
  </view>

  <!-- 空状态 -->
  <view wx:if="{{!loading && isEmptyState}}" class="empty-state">
    <image class="empty-icon" src="/images/empty-recommend.png"></image>
    <text class="empty-title">暂无推荐</text>
    <text class="empty-desc">完善您的口味档案，获得个性化推荐</text>
    <button class="empty-button" bindtap="onTasteProfileClick">完善档案</button>
  </view>

  <!-- 刷新按钮 -->
  <view class="refresh-button" bindtap="onRefresh">
    <text class="refresh-text">🔄 刷新推荐</text>
  </view>
</view> 