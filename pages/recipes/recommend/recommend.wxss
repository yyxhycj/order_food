/* pages/recipes/recommend/recommend.wxss */
.recommend-container {
  padding: 20rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

/* 页面头部 */
.page-header {
  text-align: center;
  padding: 40rpx 0 60rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  margin: -20rpx -20rpx 40rpx -20rpx;
  border-radius: 0 0 30rpx 30rpx;
  color: white;
}

.page-title {
  font-size: 56rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 20rpx;
}

.page-subtitle {
  font-size: 32rpx;
  opacity: 0.9;
  display: block;
}

/* 加载状态 */
.loading-container {
  text-align: center;
  padding: 120rpx 0;
}

.loading-text {
  font-size: 32rpx;
  color: #666;
  margin-bottom: 40rpx;
  display: block;
}

.loading-dots {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 20rpx;
}

.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #667eea;
  animation: bounce 1.4s infinite ease-in-out;
}

.dot1 {
  animation-delay: -0.32s;
}

.dot2 {
  animation-delay: -0.16s;
}

.dot3 {
  animation-delay: 0s;
}

@keyframes bounce {
  0%, 80%, 100% {
    transform: scale(0);
  }
  40% {
    transform: scale(1);
  }
}

/* 推荐概览 */
.recommendation-summary {
  margin-bottom: 40rpx;
}

.summary-card {
  background: white;
  border-radius: 20rpx;
  padding: 40rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
}

.summary-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 20rpx;
}

.summary-text {
  font-size: 30rpx;
  color: #666;
  line-height: 1.6;
  display: block;
}

/* 推荐分类 */
.recommendation-sections {
  margin-bottom: 40rpx;
}

.section {
  margin-bottom: 60rpx;
}

.section-header {
  margin-bottom: 30rpx;
  padding: 0 20rpx;
}

.section-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 10rpx;
}

.section-subtitle {
  font-size: 28rpx;
  color: #999;
  display: block;
}

/* 菜谱滚动区域 */
.recipe-scroll {
  width: 100%;
  height: 400rpx;
}

.recipe-list {
  display: flex;
  gap: 20rpx;
  padding: 0 20rpx;
}

.recipe-card {
  width: 300rpx;
  background: white;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
  position: relative;
  flex-shrink: 0;
}

.recipe-image {
  width: 100%;
  height: 200rpx;
  object-fit: cover;
}

.recipe-info {
  padding: 20rpx;
}

.recipe-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 15rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recipe-meta {
  display: flex;
  justify-content: space-between;
  margin-bottom: 15rpx;
}

.meta-item {
  font-size: 26rpx;
  color: #666;
  padding: 6rpx 12rpx;
  background: #f0f0f0;
  border-radius: 12rpx;
}

.recipe-rating {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.rating-text {
  font-size: 28rpx;
  font-weight: bold;
  color: #ff6b6b;
}

.rating-count {
  font-size: 24rpx;
  color: #999;
}

/* 推荐理由 */
.recommend-reason {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  background: rgba(102, 126, 234, 0.9);
  color: white;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  max-width: 200rpx;
}

.reason-text {
  font-size: 24rpx;
  line-height: 1.4;
}

/* 相似度分数 */
.similarity-score {
  position: absolute;
  bottom: 20rpx;
  right: 20rpx;
  background: rgba(118, 75, 162, 0.9);
  color: white;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.score-text {
  font-size: 24rpx;
  font-weight: bold;
}

/* 热门标识 */
.trend-indicator {
  position: absolute;
  top: 10rpx;
  left: 10rpx;
  background: rgba(255, 107, 107, 0.9);
  color: white;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.trend-text {
  font-size: 24rpx;
  font-weight: bold;
}

/* 推荐设置 */
.recommendation-settings {
  background: white;
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
}

.setting-header {
  margin-bottom: 30rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.setting-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.setting-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  position: relative;
}

.setting-item:last-child {
  border-bottom: none;
}

.setting-label {
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
}

.setting-desc {
  font-size: 26rpx;
  color: #999;
  margin-top: 8rpx;
}

.setting-arrow {
  font-size: 32rpx;
  color: #ccc;
  margin-left: 20rpx;
}

.picker-value {
  font-size: 30rpx;
  color: #667eea;
  font-weight: 500;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 120rpx 40rpx;
  background: white;
  border-radius: 20rpx;
  margin-bottom: 40rpx;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 40rpx;
}

.empty-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  display: block;
}

.empty-desc {
  font-size: 30rpx;
  color: #666;
  margin-bottom: 60rpx;
  display: block;
  line-height: 1.6;
}

.empty-button {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  border: none;
  border-radius: 50rpx;
  padding: 24rpx 60rpx;
  font-size: 32rpx;
  font-weight: bold;
}

.empty-button:after {
  border: none;
}

/* 刷新按钮 */
.refresh-button {
  background: white;
  border-radius: 50rpx;
  padding: 30rpx 60rpx;
  text-align: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
  margin-bottom: 40rpx;
}

.refresh-text {
  font-size: 32rpx;
  color: #667eea;
  font-weight: bold;
}

.refresh-button:active {
  transform: scale(0.98);
  transition: transform 0.1s;
}

/* 响应式设计 */
@media (max-width: 400px) {
  .recipe-card {
    width: 280rpx;
  }
  
  .page-title {
    font-size: 48rpx;
  }
  
  .section-title {
    font-size: 36rpx;
  }
}

/* 深色模式支持 */
@media (prefers-color-scheme: dark) {
  .recommend-container {
    background: #1a1a1a;
  }
  
  .summary-card,
  .recommendation-settings,
  .recipe-card,
  .refresh-button {
    background: #2d2d2d;
  }
  
  .page-title,
  .section-title,
  .summary-title,
  .setting-title,
  .recipe-name,
  .empty-title {
    color: #fff;
  }
  
  .page-subtitle,
  .section-subtitle,
  .summary-text,
  .setting-desc,
  .empty-desc {
    color: #ccc;
  }
  
  .meta-item {
    background: #3a3a3a;
    color: #ccc;
  }
} 