<view class="recipe-review">
  <!-- 菜谱信息 -->
  <view class="recipe-info">
    <image class="recipe-image" src="{{recipe.main_image}}" mode="aspectFill"></image>
    <view class="recipe-details">
      <text class="recipe-name">{{recipe.name}}</text>
      <text class="recipe-description">{{recipe.description}}</text>
      <view class="recipe-meta">
        <text class="meta-item">{{recipe.cooking_time}}分钟</text>
        <text class="meta-item">{{difficultyMap[recipe.difficulty]}}</text>
      </view>
    </view>
  </view>

  <!-- 多维度评分 -->
  <view class="rating-section">
    <view class="section-title">评分</view>
    <view class="rating-grid">
      <view class="rating-item">
        <text class="rating-label">口味还原度</text>
        <view class="star-rating">
          <block wx:for="{{[1,2,3,4,5]}}" wx:key="*this">
            <text class="star {{item <= ratings.taste ? 'star-filled' : 'star-empty'}}" 
                  bindtap="setRating" 
                  data-type="taste" 
                  data-rating="{{item}}">★</text>
          </block>
        </view>
        <text class="rating-value">{{ratings.taste}}</text>
      </view>

      <view class="rating-item">
        <text class="rating-label">操作难度</text>
        <view class="star-rating">
          <block wx:for="{{[1,2,3,4,5]}}" wx:key="*this">
            <text class="star {{item <= ratings.difficulty ? 'star-filled' : 'star-empty'}}" 
                  bindtap="setRating" 
                  data-type="difficulty" 
                  data-rating="{{item}}">★</text>
          </block>
        </view>
        <text class="rating-value">{{ratings.difficulty}}</text>
      </view>

      <view class="rating-item">
        <text class="rating-label">食材易得性</text>
        <view class="star-rating">
          <block wx:for="{{[1,2,3,4,5]}}" wx:key="*this">
            <text class="star {{item <= ratings.ingredients ? 'star-filled' : 'star-empty'}}" 
                  bindtap="setRating" 
                  data-type="ingredients" 
                  data-rating="{{item}}">★</text>
          </block>
        </view>
        <text class="rating-value">{{ratings.ingredients}}</text>
      </view>

      <view class="rating-item">
        <text class="rating-label">性价比</text>
        <view class="star-rating">
          <block wx:for="{{[1,2,3,4,5]}}" wx:key="*this">
            <text class="star {{item <= ratings.value ? 'star-filled' : 'star-empty'}}" 
                  bindtap="setRating" 
                  data-type="value" 
                  data-rating="{{item}}">★</text>
          </block>
        </view>
        <text class="rating-value">{{ratings.value}}</text>
      </view>
    </view>

    <!-- 总体评分 -->
    <view class="overall-rating">
      <text class="overall-label">总体评分</text>
      <view class="overall-stars">
        <block wx:for="{{[1,2,3,4,5]}}" wx:key="*this">
          <text class="star {{item <= overallRating ? 'star-filled' : 'star-empty'}}">★</text>
        </block>
      </view>
      <text class="overall-value">{{overallRating}}</text>
    </view>
  </view>

  <!-- 评价内容 -->
  <view class="content-section">
    <view class="section-title">评价内容</view>
    <textarea class="review-textarea" 
              placeholder="分享您的制作心得和品尝体验..." 
              value="{{reviewContent}}" 
              bindinput="onContentInput"
              maxlength="500"></textarea>
    <view class="char-count">{{reviewContent.length}}/500</view>
  </view>

  <!-- 图片上传 -->
  <view class="images-section">
    <view class="section-title">添加图片</view>
    <view class="image-upload">
      <view class="image-list">
        <block wx:for="{{uploadedImages}}" wx:key="*this">
          <view class="image-item">
            <image class="uploaded-image" src="{{item}}" mode="aspectFill"></image>
            <view class="image-delete" bindtap="removeImage" data-index="{{index}}">×</view>
          </view>
        </block>
        <view class="upload-btn" bindtap="uploadImage" wx:if="{{uploadedImages.length < 9}}">
          <text class="upload-text">+</text>
        </view>
      </view>
      <text class="upload-tip">最多上传9张图片</text>
    </view>
  </view>

  <!-- 季节标签 -->
  <view class="season-section">
    <view class="section-title">季节标签</view>
    <view class="season-tags">
      <block wx:for="{{seasonOptions}}" wx:key="*this">
        <view class="season-tag {{selectedSeason === item.value ? 'selected' : ''}}" 
              bindtap="selectSeason" 
              data-season="{{item.value}}">
          <text class="season-text">{{item.label}}</text>
        </view>
      </block>
    </view>
  </view>

  <!-- 挑战类型 -->
  <view class="challenge-section">
    <view class="section-title">挑战类型</view>
    <view class="challenge-types">
      <block wx:for="{{challengeOptions}}" wx:key="*this">
        <view class="challenge-type {{selectedChallenge === item.value ? 'selected' : ''}}" 
              bindtap="selectChallenge" 
              data-challenge="{{item.value}}">
          <image class="challenge-icon" src="{{item.icon}}"></image>
          <text class="challenge-text">{{item.label}}</text>
        </view>
      </block>
    </view>
  </view>

  <!-- 评价预览 -->
  <view class="preview-section">
    <view class="section-title">评价预览</view>
    <view class="review-preview">
      <view class="preview-header">
        <image class="user-avatar" src="{{userInfo.avatar || '/images/default-avatar.png'}}" mode="aspectFill"></image>
        <view class="user-info">
          <text class="user-name">{{userInfo.nickname || '匿名用户'}}</text>
          <view class="preview-rating">
            <block wx:for="{{[1,2,3,4,5]}}" wx:key="*this">
              <text class="star {{item <= overallRating ? 'star-filled' : 'star-empty'}}">★</text>
            </block>
          </view>
        </view>
        <text class="preview-date">刚刚</text>
      </view>
      <view class="preview-content">{{reviewContent || '暂无评价内容'}}</view>
      <view class="preview-images" wx:if="{{uploadedImages.length > 0}}">
        <block wx:for="{{uploadedImages}}" wx:key="*this">
          <image class="preview-image" src="{{item}}" mode="aspectFill"></image>
        </block>
      </view>
      <view class="preview-tags">
        <view class="preview-tag season" wx:if="{{selectedSeason}}">
          {{seasonMap[selectedSeason]}}
        </view>
        <view class="preview-tag challenge" wx:if="{{selectedChallenge}}">
          {{challengeMap[selectedChallenge]}}
        </view>
      </view>
    </view>
  </view>

  <!-- 提交按钮 -->
  <view class="submit-section">
    <button class="submit-btn" bindtap="submitReview" disabled="{{!canSubmit}}">
      提交评价
    </button>
  </view>
</view> 