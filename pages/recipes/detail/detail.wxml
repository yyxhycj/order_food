<view class="recipe-detail">
  <!-- 菜谱头部信息 -->
  <view class="recipe-header">
    <image class="recipe-image" src="{{recipe.main_image || '/images/default-recipe.jpg'}}" mode="aspectFill"></image>
    <view class="recipe-info">
      <view class="recipe-title">{{recipe.name}}</view>
      <view class="recipe-meta">
        <view class="meta-item">
          <text class="meta-label">制作时间:</text>
          <text class="meta-value">{{recipe.cooking_time}}分钟</text>
        </view>
        <view class="meta-item">
          <text class="meta-label">难度:</text>
          <text class="meta-value difficulty-{{recipe.difficulty}}">{{difficultyMap[recipe.difficulty]}}</text>
        </view>
        <view class="meta-item">
          <text class="meta-label">评分:</text>
          <view class="rating-display">
            <view class="stars">
              <block wx:for="{{[1,2,3,4,5]}}" wx:key="*this">
                <text class="star {{item <= recipe.average_rating ? 'star-filled' : 'star-empty'}}">★</text>
              </block>
            </view>
            <text class="rating-text">{{recipe.average_rating}}</text>
          </view>
        </view>
      </view>
      <view class="recipe-description">{{recipe.description}}</view>
    </view>
  </view>

  <!-- 统计信息 -->
  <view class="recipe-stats">
    <view class="stat-item" bindtap="toggleLike">
      <image class="stat-icon" src="{{recipe.is_liked ? '/images/heart-filled.png' : '/images/heart.png'}}"></image>
      <text class="stat-text">{{recipe.like_count}}</text>
    </view>
    <view class="stat-item" bindtap="toggleCollect">
      <image class="stat-icon" src="{{recipe.is_collected ? '/images/star-filled.png' : '/images/star.png'}}"></image>
      <text class="stat-text">{{recipe.collect_count}}</text>
    </view>
    <view class="stat-item" bindtap="shareRecipe">
      <image class="stat-icon" src="/images/share.png"></image>
      <text class="stat-text">分享</text>
    </view>
    <view class="stat-item">
      <image class="stat-icon" src="/images/view.png"></image>
      <text class="stat-text">{{recipe.view_count}}</text>
    </view>
  </view>

  <!-- 营养信息 -->
  <view class="nutrition-section" wx:if="{{recipe.nutrition_info}}">
    <view class="section-title">营养信息</view>
    <view class="nutrition-grid">
      <block wx:for="{{nutritionData}}" wx:key="key">
        <view class="nutrition-item">
          <text class="nutrition-label">{{item.label}}</text>
          <text class="nutrition-value">{{item.value}}</text>
        </view>
      </block>
    </view>
  </view>

  <!-- 食材清单 -->
  <view class="ingredients-section">
    <view class="section-title">食材清单</view>
    <view class="ingredients-list">
      <block wx:for="{{ingredients}}" wx:key="id">
        <view class="ingredient-item">
          <text class="ingredient-name">{{item.name}}</text>
          <text class="ingredient-amount">{{item.amount}}</text>
        </view>
      </block>
    </view>
  </view>

  <!-- 制作步骤 -->
  <view class="steps-section">
    <view class="section-title">制作步骤</view>
    <view class="steps-list">
      <block wx:for="{{steps}}" wx:key="index">
        <view class="step-item">
          <view class="step-number">{{index + 1}}</view>
          <view class="step-content">
            <view class="step-text">{{item.description}}</view>
            <image wx:if="{{item.image}}" class="step-image" src="{{item.image}}" mode="aspectFill"></image>
          </view>
        </view>
      </block>
    </view>
  </view>

  <!-- 制作视频 -->
  <view class="video-section" wx:if="{{recipe.video_url}}">
    <view class="section-title">制作视频</view>
    <video class="recipe-video" src="{{recipe.video_url}}" controls></video>
  </view>

  <!-- 相关菜谱推荐 -->
  <view class="related-section" wx:if="{{relatedRecipes.length > 0}}">
    <view class="section-title">相关推荐</view>
    <scroll-view class="related-scroll" scroll-x="true">
      <block wx:for="{{relatedRecipes}}" wx:key="id">
        <view class="related-item" bindtap="goToRecipe" data-id="{{item.id}}">
          <image class="related-image" src="{{item.main_image}}" mode="aspectFill"></image>
          <view class="related-info">
            <text class="related-title">{{item.name}}</text>
            <text class="related-rating">★{{item.average_rating}}</text>
          </view>
        </view>
      </block>
    </scroll-view>
  </view>

  <!-- 评价区域 -->
  <view class="reviews-section">
    <view class="section-title">用户评价 ({{recipe.review_count}})</view>
    
    <!-- 评价统计 -->
    <view class="review-stats">
      <view class="overall-rating">
        <text class="overall-score">{{recipe.average_rating}}</text>
        <view class="overall-stars">
          <block wx:for="{{[1,2,3,4,5]}}" wx:key="*this">
            <text class="star {{item <= recipe.average_rating ? 'star-filled' : 'star-empty'}}">★</text>
          </block>
        </view>
      </view>
      <view class="rating-breakdown">
        <block wx:for="{{ratingBreakdown}}" wx:key="rating">
          <view class="rating-bar">
            <text class="rating-label">{{item.rating}}星</text>
            <view class="rating-progress">
              <view class="rating-fill" style="width: {{item.percentage}}%"></view>
            </view>
            <text class="rating-count">{{item.count}}</text>
          </view>
        </block>
      </view>
    </view>

    <!-- 评价列表 -->
    <view class="reviews-list">
      <block wx:for="{{reviews}}" wx:key="id">
        <view class="review-item">
          <view class="review-header">
            <image class="reviewer-avatar" src="{{item.user.avatar || '/images/default-avatar.png'}}" mode="aspectFill"></image>
            <view class="reviewer-info">
              <text class="reviewer-name">{{item.user.nickname}}</text>
              <view class="review-rating">
                <block wx:for="{{[1,2,3,4,5]}}" wx:key="*this" wx:for-item="star">
                  <text class="star {{star <= item.overall_rating ? 'star-filled' : 'star-empty'}}">★</text>
                </block>
              </view>
            </view>
            <text class="review-date">{{item.created_at}}</text>
          </view>
          <view class="review-content">{{item.content}}</view>
          <view class="review-images" wx:if="{{item.images.length > 0}}">
            <block wx:for="{{item.images}}" wx:key="*this" wx:for-item="image">
              <image class="review-image" src="{{image}}" mode="aspectFill" bindtap="previewImage" data-src="{{image}}"></image>
            </block>
          </view>
          <view class="review-actions">
            <view class="review-action" bindtap="likeReview" data-id="{{item.id}}">
              <image class="action-icon" src="{{item.is_liked ? '/images/thumb-up-filled.png' : '/images/thumb-up.png'}}"></image>
              <text class="action-text">{{item.likes_count}}</text>
            </view>
          </view>
        </view>
      </block>
    </view>

    <!-- 查看更多评价 -->
    <view class="more-reviews" bindtap="loadMoreReviews" wx:if="{{hasMoreReviews}}">
      <text class="more-text">查看更多评价</text>
    </view>
  </view>

  <!-- 底部操作栏 -->
  <view class="bottom-bar">
    <button class="action-btn secondary" bindtap="goToCreate">创建菜谱</button>
    <button class="action-btn primary" bindtap="writeReview">写评价</button>
  </view>
</view> 